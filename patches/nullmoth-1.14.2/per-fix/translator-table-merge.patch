+// The translator's own table at TABLE_BINDING, if the module has one in the layout this pass emits (StorageBuffer, set 0,
+// one-member block holding an array of u64 with stride 8). Keep = a table this pass cannot extend.
+fn merge_table(m: &rspirv::dr::Module, defs: &HashMap<u32, Instruction>, bindings: &HashMap<u32, u32>) -> Merge {
+    if std::env::var_os("NVMTL_NO_TABLE_MERGE").is_some() {
+        return if bindings.values().any(|b| *b == TABLE_BINDING) { Merge::Keep } else { Merge::None };
+    }
+    let Some((&var, _)) = bindings.iter().find(|(_, b)| **b == TABLE_BINDING) else { return Merge::None };
+    let Some(v) = defs.get(&var).filter(|i| i.class.opcode == Op::Variable && i.operands.first() == Some(&Operand::StorageClass(StorageClass::StorageBuffer))) else { return Merge::Keep };
+    let Some(pt) = v.result_type.and_then(|t| defs.get(&t)) else { return Merge::Keep };
+    let Some(block) = pt.operands.get(1).and_then(id).and_then(|b| defs.get(&b)) else { return Merge::Keep };
+    if block.class.opcode != Op::TypeStruct || block.operands.len() != 1 { return Merge::Keep; }
+    let Some(arr) = id(&block.operands[0]).and_then(|a| defs.get(&a)) else { return Merge::Keep };
+    if !matches!(arr.class.opcode, Op::TypeRuntimeArray | Op::TypeArray) { return Merge::Keep; }
+    let Some(elem) = arr.operands.first().and_then(id) else { return Merge::Keep };
+    // u64 entries, or uvec2 (the translator's native table reads texture metadata as two u32 words)
+    let pair = match defs.get(&elem).map(|e| (e.class.opcode, e.operands.clone())) {
+        Some((Op::TypeInt, o)) if o == vec![Operand::LiteralBit32(64), Operand::LiteralBit32(0)] => false,
+        Some((Op::TypeVector, o)) if o.len() == 2 && o[1] == Operand::LiteralBit32(2)
+            && id(&o[0]).and_then(|c| defs.get(&c)).is_some_and(|c| c.class.opcode == Op::TypeInt && c.operands == vec![Operand::LiteralBit32(32), Operand::LiteralBit32(0)]) => true,
+        _ => return Merge::Keep,
+    };
+    let stride = m.annotations.iter().find_map(|a| match a.operands.as_slice() {
+        [Operand::IdRef(n), Operand::Decoration(Decoration::ArrayStride), Operand::LiteralBit32(s)] if Some(*n) == arr.result_id => Some(*s), _ => None });
+    if stride != Some(8) { return Merge::Keep; }
+    let set = m.annotations.iter().find_map(|a| match a.operands.as_slice() {
+        [Operand::IdRef(n), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(s)] if *n == var => Some(*s), _ => None });
+    if set != Some(0) { return Merge::Keep; }
+    Merge::Into(Table { var, elem, pair })
