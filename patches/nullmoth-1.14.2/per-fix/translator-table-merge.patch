+// Pointer types of the table variable and of every pointer derived from it: they stay StorageBuffer pointers (the
+// conversion to physical pointers below must not touch them), and a buffer that shares one of them keeps the module as is.
+fn table_pointer_types(m: &rspirv::dr::Module, table: u32) -> (HashSet<u32>, Vec<u32>, bool) {
+    let mut derived: HashSet<u32> = HashSet::from([table]);
+    let mut types = HashSet::new();
+    if let Some(t) = m.types_global_values.iter().find(|i| i.result_id == Some(table)).and_then(|i| i.result_type) { types.insert(t); }
+    loop {
+        let before = derived.len();
+        for i in m.all_inst_iter() {
+            if matches!(i.class.opcode, Op::AccessChain | Op::InBoundsAccessChain | Op::PtrAccessChain | Op::CopyObject)
+                && i.operands.first().and_then(id).is_some_and(|b| derived.contains(&b)) {
+                if let Some(r) = i.result_id { derived.insert(r); }
+                if let Some(t) = i.result_type { types.insert(t); }
+            }
+        }
+        if derived.len() == before { break; }
+    }
+    // values not derived from the table that have one of its pointer types (a buffer element pointer of the same type, e.g.
+    // StorageBuffer u32): the caller gives them a pointer type of their own. Anything but a plain access chain/copy there
+    // (function parameter, phi, select, call) could mix table and buffer pointers, so the module is kept as it is.
+    let mut other = Vec::new(); let mut conflict = false;
+    for i in m.all_inst_iter() {
+        if let (Some(t), Some(r)) = (i.result_type, i.result_id) {
+            if types.contains(&t) && !derived.contains(&r) && r != table {
+                if matches!(i.class.opcode, Op::AccessChain | Op::InBoundsAccessChain | Op::PtrAccessChain | Op::CopyObject) { other.push(r); }
+                else { conflict = true; }
+            }
+        }
+    }
+    (types, other, conflict)
+}
