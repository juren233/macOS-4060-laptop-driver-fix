+/* Local (eager submit, NVMTL_GSUB_EAGER, default on): run the submit-ahead pass as soon as a buffer is committed, on its own serial
+ * queue, instead of only at the top of the execution worker's loop. The worker blocks while it waits for a part to finish and
+ * publishes its IOSurfaces; buffers committed meanwhile were neither submitted nor "scheduled" until it came back, so Chrome's
+ * waitUntilScheduled waited for the previous frame's GPU work + readback (31% of CrGpuMain with Bilibili's smart danmaku mask). */
+static BOOL nvmtl_gsub_eager_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_GSUB_EAGER"); on = !(e && e[0] == '0');
+        nvlog("commit: eager submit-ahead %s (NVMTL_GSUB_EAGER=%s)", on ? "ON - committed buffers are submitted at once on nvmtl.submit" : "off - only the execution worker submits ahead", e ? e : "unset"); }
+    return on;
+}
+static _Atomic int nvmtl_eager_queued;
+static void nvmtl_gsub_eager_kick(void) {
+    static dispatch_once_t once; static dispatch_queue_t q;
+    dispatch_once(&once, ^{ q = dispatch_queue_create("nvmtl.submit", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0)); });
+    // A full in-flight window has nothing to submit; the worker's own pass refills it as parts finish.
+    if (atomic_load(&gsub_inflight) >= nvmtl_gsub_cap()) return;
+    if (atomic_exchange(&nvmtl_eager_queued, 1)) return;
