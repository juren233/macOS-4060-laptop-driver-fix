+static void *nvbf_errfwd_thread(void *arg)
+{
+    int fd = (int)(intptr_t)arg; char buf[2048]; size_t n = 0; char c;
+    while (read(fd, &c, 1) == 1) { if (c == '\n' || n == sizeof buf - 1) { buf[n] = 0; if (n) syslog(LOG_ERR, "NullMoth-diag: STDERR %s", buf); n = 0; } else buf[n++] = c; }
