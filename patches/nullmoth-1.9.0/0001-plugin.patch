+/* ===== LOCAL-FIX (this Hackintosh, RTX 4060 / macOS 15): scheduled handlers fire at GPU completion
+ * DO NOT REMOVE, REVERT OR 'SIMPLIFY' when merging upstream NullMoth changes - without it Chrome/Electron (ZCode, Claude...) flicker: Chromium reads the IOSurface as soon as 'scheduled' fires, but here the GPU publishes later.
+ * History: git log in ~/work/nvidia-setup/src/repo (branch local-mods). Installed + guarded by ~/work/system/nvguard. ===== */
+static const char kNVDeferredSched = 0;
 - (void)nvmtlMarkScheduled {
     [_completionCondition lock];
     if (!_wasScheduled) {
         _wasScheduled = YES; _cbstatus = MTLCommandBufferStatusScheduled;
         NSArray *handlers = [_scheduledHandlers copy]; [_scheduledHandlers removeAllObjects];
+        // Chromium (Dawn/Graphite, ANGLE) treats "scheduled" as "WindowServer may now read the IOSurface". On Apple GPUs queue order makes that true;
+  // here the surface is only finished (and published) at completion, so handing it over earlier showed older frames (ZCode flicker).
+  { static int late = -1; if (late < 0) { const char *e = getenv("NVMTL_SCHED_AT_COMPLETION"); late = !(e && *e == '0'); }
