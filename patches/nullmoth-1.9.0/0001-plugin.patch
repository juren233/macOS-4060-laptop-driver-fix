diff --git a/plugin/nvmtl_diag.h b/plugin/nvmtl_diag.h
new file mode 100644
index 0000000..6b33540
--- /dev/null
+++ b/plugin/nvmtl_diag.h
@@ -0,0 +1,82 @@
+// IOSurface diagnostics that reach the system log even in a release build (tag "NullMoth-diag"), plus a per-surface record
+// of this process's GPU writes so a surface-in can tell when the shared VRAM is about to receive newer GPU contents.
+#pragma once
+#include <syslog.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <os/lock.h>
+#include <time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/time.h>
+#include <stdlib.h>
+static void nvdiag_emit(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvdiag_emit(const char *fmt, ...) {
+    char b[600]; va_list a; va_start(a, fmt); vsnprintf(b, sizeof b, fmt, a); va_end(a);
+    syslog(LOG_ERR, "NullMoth-diag: %s", b);
+}
+#define NVDIAG(lim, ...) do { static _Atomic unsigned nvd_c_; const unsigned nvd_k_ = atomic_fetch_add(&nvd_c_, 1); \
+    if (nvd_k_ < (unsigned)(lim) || !(nvd_k_ % 2000)) nvdiag_emit(__VA_ARGS__); } while (0)
+#define NVSD_N 4096
+static struct { uint32_t id; uint64_t dirty, out; uint32_t dn, on; } g_nvsd[NVSD_N];
+static os_unfair_lock g_nvsd_l = OS_UNFAIR_LOCK_INIT;
+static int nvsd_slot(uint32_t id) {
+    const unsigned h = (id * 2654435761u) % NVSD_N;
+    for (unsigned k = 0; k < 32; k++) { const unsigned i = (h + k) % NVSD_N; if (g_nvsd[i].id == id || !g_nvsd[i].id) return (int)i; }
+    return (int)h;
+}
+// what: 0 = a GPU write was encoded, 1 = the writes were published (surface-out after completion)
+static void nvsd_mark(uint32_t id, int what) {
+    if (!id) return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id);
+    if (g_nvsd[i].id != id) { g_nvsd[i].id = id; g_nvsd[i].dirty = g_nvsd[i].out = 0; g_nvsd[i].dn = g_nvsd[i].on = 0; }
+    // Counted, not timestamped: a publish of frame N that lands after frame N+1 was encoded must not hide N+1's write.
+    if (what) { g_nvsd[i].out = now; if (g_nvsd[i].on < g_nvsd[i].dn) g_nvsd[i].on++; }
+    else { g_nvsd[i].dirty = now; g_nvsd[i].dn++; }
+    os_unfair_lock_unlock(&g_nvsd_l);
+}
+static int nvsd_pending(uint32_t id) {
+    if (!id) return 0;
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id); const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    // The age limit keeps a write that is never published (command buffer dropped) from blocking uploads for good.
+    const int p = g_nvsd[i].id == id && g_nvsd[i].dn > g_nvsd[i].on && now - g_nvsd[i].dirty < 500000000ull;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    return p;
+}
+static int nvsd_guard_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_SURFIN_GUARD"); on = !(e && e[0] == '0');
+        nvdiag_emit("surface-in guard %s (NVMTL_SURFIN_GUARD=%s): a texture over shared IOSurface VRAM that this process has GPU writes "
+                    "in flight for does %s upload the surface's CPU pages over it", on ? "ON" : "off", e ? e : "unset", on ? "NOT" : "still"); }
+    return on;
+}
+
+// Window-sized shared-VRAM IOSurfaces (>= NVMTL_SURF_SHARE_MINPX pixels, below the 7.2M-pixel scan-out framebuffers): every
+// event on them goes to /private/var/tmp/nvmtl-big.log (not the system log: its per-call-site caps were used up at boot).
+// The budget is per process; the draw trace spends ~7 lines per draw, and the post-login window churn alone ran at ~4000
+// lines/s, so the cap must be large enough to survive a login burst plus the repro. With the trace switch absent nothing
+// is written and nothing is consumed, so the budget only ever burns while a repro is actually running.
+#define NVBIG_RANGE(w, h) ((unsigned long)(w) * (unsigned long)(h) >= 3000000ul && (unsigned long)(w) * (unsigned long)(h) < 7000000ul)
+#define NVBIG_BUDGET 2000000u
+static void nvbig(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvbig(const char *fmt, ...) {
+    static _Atomic unsigned n; static int fd = -2;
+    static _Atomic uint64_t gate_at; static _Atomic int gate_on;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= atomic_load_explicit(&gate_at, memory_order_relaxed)) {
+        atomic_store_explicit(&gate_at, now + 250000000ull, memory_order_relaxed);
+        atomic_store_explicit(&gate_on, access("/private/var/tmp/nvmtl-trace-request", F_OK) == 0, memory_order_relaxed);
+    }
+    if (!atomic_load_explicit(&gate_on, memory_order_relaxed)) return;
+    if (atomic_fetch_add(&n, 1) >= NVBIG_BUDGET) return;
+    if (fd == -2) fd = open("/private/var/tmp/nvmtl-big.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
+    if (fd < 0) return;
+    char b[700]; struct timeval tv; gettimeofday(&tv, NULL); struct tm tm; time_t t = tv.tv_sec; localtime_r(&t, &tm);
+    int k = snprintf(b, sizeof b, "%02d:%02d:%02d.%03d %s[%d] ", tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000), getprogname(), (int)getpid());
+    va_list a; va_start(a, fmt); k += vsnprintf(b + k, sizeof b - (size_t)k - 2, fmt, a); va_end(a);
+    if (k > (int)sizeof b - 2) k = (int)sizeof b - 2;
+    b[k++] = '\n'; (void)!write(fd, b, (size_t)k);
+}
