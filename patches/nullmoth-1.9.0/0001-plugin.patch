+    { NSArray *ds = objc_getAssociatedObject(self, &kNVDeferredSched); if (ds) { objc_setAssociatedObject(self, &kNVDeferredSched, nil, OBJC_ASSOCIATION_RETAIN); [self nvmtlDispatchHandlers:ds scheduled:YES]; } }
