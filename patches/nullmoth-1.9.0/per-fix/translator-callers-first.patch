+
+// Local fix (DO-NOT-REVERT): a helper's raw buffer pointer parameter takes the constant byte offset that its CALL records in
+// raw_call_param_offsets, so the call must be emitted before the helper. AIR defines helpers before their callers; emitted
+// in that order the parameter silently fell back to the buffer root (offset 0) - Core Image's _lanczosDownH read its sampler
+// transform from byte 0 instead of 80 and every Lanczos-scaled image (Preview, screenshot thumbnails) came out as flat tiles.
+// Only modules where such a helper precedes one of its callers are reordered (stable, callers first); the rest keep IR order.
+fn callers_before_pointer_helpers(functions: Vec<LlFunction>) -> Vec<LlFunction> {
+    let index: HashMap<&str, usize> = functions
+        .iter()
+        .enumerate()
+        .map(|(i, f)| (f.name.as_str(), i))
+        .collect();
+    let mut callees: Vec<Vec<usize>> = vec![Vec::new(); functions.len()];
+    let mut needed = false;
+    for (i, f) in functions.iter().enumerate() {
+        for inst in f.carrier_insts() {
+            let Some(call) = inst.call().as_deref() else {
+                continue;
+            };
+            let Some(&j) = index.get(call.callee.as_str()) else {
+                continue;
+            };
+            if j == i || callees[i].contains(&j) {
+                continue;
+            }
+            callees[i].push(j);
+            needed |= j < i
+                && functions[j]
+                    .params
+                    .iter()
+                    .any(|(_, ty)| matches!(ty, LlType::Ptr(1 | 2)));
+        }
+    }
+    if !needed {
+        return functions;
+    }
+    let mut callers = vec![0usize; functions.len()];
+    for list in &callees {
+        for &j in list {
+            callers[j] += 1;
+        }
+    }
+    let mut ready: std::collections::BTreeSet<usize> =
+        (0..functions.len()).filter(|&i| callers[i] == 0).collect();
+    let mut order = Vec::with_capacity(functions.len());
+    while let Some(i) = ready.pop_first() {
+        order.push(i);
+        for &j in &callees[i] {
+            callers[j] -= 1;
+            if callers[j] == 0 {
+                ready.insert(j);
+            }
+        }
+    }
+    if order.len() != functions.len() {
+        return functions;
+    }
+    let mut slots: Vec<Option<LlFunction>> = functions.into_iter().map(Some).collect();
+    order
+        .into_iter()
+        .map(|i| slots[i].take().expect("each function is ordered once"))
+        .collect()
+}
