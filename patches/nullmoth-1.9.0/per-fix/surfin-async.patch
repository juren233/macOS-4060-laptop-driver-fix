+// whole surface into a staging buffer with the CPU and then waits for the GPU; while a page scrolls or a video plays that
+// was ~70% of WindowServer's main thread (spindump 2026-10-09: memmove page faults + vkWaitForFences under nvmtlSurfaceIn).
+// Here the copy is SUBMITTED and not waited for: queue order puts it ahead of every later submission (the command buffer
+// that samples the texture is committed after this call), and the barrier at its end makes the transfer visible to them.
+// `direct` = the surface's own pages imported as a buffer: the GPU reads them itself and the CPU copies nothing.
+// `hold` (released through `rel` once the copy completed) keeps the texture, its image and that import alive; on failure
+// it is NOT consumed. NVMTL_SURFIN_ASYNC=0 (nvrm610.conf) brings back the synchronous upload.
+#define NVMTL_UPL_INFLIGHT 48u
+typedef struct nvmtl_upl { nvk_cmdbuf c; nvmtl_inflight f; nvk_buffer stage; void *hold; void (*rel)(void *); struct nvmtl_upl *next; } nvmtl_upl;
+static pthread_mutex_t g_upl_lock = PTHREAD_MUTEX_INITIALIZER;
