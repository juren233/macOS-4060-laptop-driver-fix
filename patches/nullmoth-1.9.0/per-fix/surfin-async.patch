+// Finish the uploads whose fence signalled; while more than `keep` are in flight, wait for the oldest.
+static void nvmtl_upl_reap(unsigned keep)
+{
+    for (;;) {
+        pthread_mutex_lock(&g_upl_lock);
+        nvmtl_upl *u = g_upl_head;
+        if (!u || (g_state == 1 && g_upl_n <= keep && pvkGetFenceStatus(g_dev, (VkFence)u->f.fence) != VK_SUCCESS)) { pthread_mutex_unlock(&g_upl_lock); return; }
