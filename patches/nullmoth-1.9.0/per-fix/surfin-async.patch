+              : "copy on the CPU and wait for the GPU (old)", e ? e : "unset"); }
+    return on;
+}
+static void nvmtl_upl_done(nvmtl_upl *u)
+{
+    const int r = nvmtl_vk_submit_finish(&u->f);
+    if (r == -2) { g_upl_fail++; free(u); return; }   // device lost: keep what the GPU may still touch, like submit_finish does
