+// IOSurface diagnostics that reach the system log even in a release build (tag "NullMoth-diag"), plus a per-surface record
+// of this process's GPU writes so a surface-in can tell when the shared VRAM is about to receive newer GPU contents.
+#pragma once
+#include <syslog.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <os/lock.h>
+#include <time.h>
+static void nvdiag_emit(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvdiag_emit(const char *fmt, ...) {
+    char b[600]; va_list a; va_start(a, fmt); vsnprintf(b, sizeof b, fmt, a); va_end(a);
+    syslog(LOG_ERR, "NullMoth-diag: %s", b);
+}
+#define NVDIAG(lim, ...) do { static _Atomic unsigned nvd_c_; const unsigned nvd_k_ = atomic_fetch_add(&nvd_c_, 1); \
+    if (nvd_k_ < (unsigned)(lim) || !(nvd_k_ % 2000)) nvdiag_emit(__VA_ARGS__); } while (0)
+#define NVSD_N 4096
+static struct { uint32_t id; uint64_t dirty, out; } g_nvsd[NVSD_N];
+static os_unfair_lock g_nvsd_l = OS_UNFAIR_LOCK_INIT;
+static int nvsd_slot(uint32_t id) {
+    const unsigned h = (id * 2654435761u) % NVSD_N;
+    for (unsigned k = 0; k < 32; k++) { const unsigned i = (h + k) % NVSD_N; if (g_nvsd[i].id == id || !g_nvsd[i].id) return (int)i; }
+    return (int)h;
+}
+// what: 0 = a GPU write was encoded, 1 = the writes were published (surface-out after completion)
+static void nvsd_mark(uint32_t id, int what) {
+    if (!id) return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id);
+    if (g_nvsd[i].id != id) { g_nvsd[i].id = id; g_nvsd[i].dirty = g_nvsd[i].out = 0; }
+    if (what) g_nvsd[i].out = now; else g_nvsd[i].dirty = now;
+    os_unfair_lock_unlock(&g_nvsd_l);
+}
+static int nvsd_pending(uint32_t id) {
+    if (!id) return 0;
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id); const int p = g_nvsd[i].id == id && g_nvsd[i].dirty > g_nvsd[i].out;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    return p;
+}
+static int nvsd_guard_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_SURFIN_GUARD"); on = !(e && e[0] == '0');
+        nvdiag_emit("surface-in guard %s (NVMTL_SURFIN_GUARD=%s): a texture over shared IOSurface VRAM that this process has GPU writes "
+                    "in flight for does %s upload the surface's CPU pages over it", on ? "ON" : "off", e ? e : "unset", on ? "NOT" : "still"); }
+    return on;
+}
