diff --git a/kexts/NVRM/NVRM.cpp b/kexts/NVRM/NVRM.cpp
index c88cbfc..9efe43d 100644
--- a/kexts/NVRM/NVRM.cpp
+++ b/kexts/NVRM/NVRM.cpp
@@ -578,9 +578,13 @@ void NVRM::autoGo(void *p0, wait_result_t)
         LOG("auto-go: display stack: %s", sum);
         s->releaseBootHold(armed == 1 && ag == 1 && iop == 1 ? "display armed" : "display PARTIAL");
         if (armed == 1 && iop == 1 && !PE_parse_boot_argn("-nvrmnoflip", nb, sizeof(nb))) {
