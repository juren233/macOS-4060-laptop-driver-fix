+// ---- built-in panel backlight ----
+// NVDSM (Lilu) captures NVKMS's backlight registration and publishes the resource "NVDSMBacklight": get/set the panel
+// backlight in percent through nvKmsGet/SetBacklight (GSP, PWM pin). With it, the internal panel's framebuffer
+//  - reports kIOConnectionBuiltIn and an LCD Apple sense, and a service named "backlight" exists before the first
+//    IOFramebuffer::open (gIOFBHaveBacklight): IOGraphics then attaches AppleBacklightDisplay instead of AppleDisplay;
+//  - provides the IODisplay "brightness" parameter through NVRMBacklightHandler, a child of this framebuffer
+//    (IODisplay::start collects the handlers below it), so DisplayServices, Control Center and the brightness keys
+//    can change it. Sets run on a thread call: IODisplay calls handlers with the fb lock held.
+struct NVDSMBacklightAPI {
+    uint32_t version;   // 1
+    IOReturn (*get)(uint32_t *pct);
+    IOReturn (*set)(uint32_t pct);
+};
+static NVDSMBacklightAPI gBlApi;
+#define BLLOG(fmt, ...) do { IOLog("NVRM-fb: " fmt "\n", ##__VA_ARGS__); kprintf("NVRM-fb: " fmt "\n", ##__VA_ARGS__); } while (0)
+static IOService *gBlNub;
+
+static bool blApiLoad()
+{
+    if (gBlApi.version == 1) return true;
+    OSObject *o = IOService::getResourceService()->copyProperty("NVDSMBacklight");
+    OSData *d = OSDynamicCast(OSData, o);
+    if (d && d->getLength() >= sizeof gBlApi) {
+        NVDSMBacklightAPI a; memcpy(&a, d->getBytesNoCopy(), sizeof a);
+        if (a.version == 1 && a.get && a.set) gBlApi = a;
+    }
+    OSSafeReleaseNULL(o);
+    return gBlApi.version == 1;
+}
+
+class NVRMBacklightHandler : public IODisplayParameterHandler
+{
+    OSDeclareDefaultStructors(NVRMBacklightHandler)
+public:
+    // WindowServer (CoreDisplay's IOBacklight path) drives "linear-brightness" and converts with the "-probe" pair;
+    // older clients use "brightness". All four share one 0..kMax scale: the panel PWM is linear in luminance and the
+    // user <-> linear curve is identity here, so a probe of one just mirrors into the other.
+    static constexpr SInt32 kMax = 1024;
+    IODisplay *fDisplay = nullptr;
+    thread_call_t fCall = nullptr;
+    volatile SInt32 fTarget = -1;
+    SInt32 fUi = kMax;
+    uint32_t fLastPct = 101;
+    const OSSymbol *fLin = nullptr, *fLinProbe = nullptr, *fProbe = nullptr;
+
+    static NVRMBacklightHandler *withPercent(uint32_t pct) {
+        NVRMBacklightHandler *h = new NVRMBacklightHandler;
+        if (h && !h->init()) { h->release(); return nullptr; }
+        if (h) {
+            h->fCall = thread_call_allocate(work, h);
+            h->fUi = (SInt32)((pct > 100 ? 100 : pct) * kMax / 100);
+            h->fLastPct = pct;
+            h->fLin = OSSymbol::withCStringNoCopy(kIODisplayLinearBrightnessKey);
+            h->fLinProbe = OSSymbol::withCStringNoCopy(kIODisplayLinearBrightnessProbeKey);
+            h->fProbe = OSSymbol::withCStringNoCopy(kIODisplayBrightnessProbeKey);
+        }
+        return h;
+    }
+    static uint32_t uiToPct(SInt32 ui) {
+        if (ui < 0) ui = 0;
+        if (ui > kMax) ui = kMax;
+        uint32_t pct = (uint32_t)((ui * 100 + kMax / 2) / kMax);
+        return pct ? pct : 1;   // 0 % switches the panel backlight off; the bottom of the slider stays readable
+    }
+    static void work(thread_call_param_t p0, thread_call_param_t) {
+        NVRMBacklightHandler *h = (NVRMBacklightHandler *)p0;
+        SInt32 ui = h->fTarget;
+        if (ui < 0) return;
+        uint32_t pct = uiToPct(ui);
+        if (pct == h->fLastPct) return;
+        IOReturn r = gBlApi.set ? gBlApi.set(pct) : kIOReturnNotReady;
+        if (r == kIOReturnSuccess) h->fLastPct = pct;
+        static unsigned logged;
+        if (++logged <= 16 || r != kIOReturnSuccess) BLLOG("backlight: %d/%d -> %u %% (0x%x)", (int)ui, (int)kMax, pct, r);
+    }
+    // Updates another parameter's current value in the display's live IODisplayParameters (in place, like IODisplay).
+    void mirror(const OSSymbol *key, SInt32 value) {
+        if (!fDisplay || !key) return;
+        OSObject *prop = fDisplay->copyProperty(gIODisplayParametersKey);
+        if (OSDictionary *dict = OSDynamicCast(OSDictionary, prop)) IODisplay::setParameter(dict, key, value);
+        OSSafeReleaseNULL(prop);
+    }
+    bool setDisplay(IODisplay *display) override {
+        fDisplay = display;
+        if (!display) return false;
+        OSObject *prop = display->copyProperty(gIODisplayParametersKey);
+        OSDictionary *cur = OSDynamicCast(OSDictionary, prop);
+        OSDictionary *dict = cur ? OSDictionary::withDictionary(cur) : OSDictionary::withCapacity(4);
+        OSSafeReleaseNULL(prop);
+        if (!dict) return false;
+        const OSSymbol *keys[] = { gIODisplayBrightnessKey, fLin, fProbe, fLinProbe };
+        for (const OSSymbol *k : keys) {
+            if (!k) continue;
+            IODisplay::addParameter(dict, k, 0, kMax);
+            IODisplay::setParameter(dict, k, fUi);
+        }
+        display->setProperty(gIODisplayParametersKey, dict);
+        dict->release();
+        BLLOG("backlight: brightness/linear-brightness parameters on %s (%d/%d)", display->getMetaClass()->getClassName(), (int)fUi, (int)kMax);
+        return true;
+    }
+    bool doIntegerSet(OSDictionary *, const OSSymbol *paramName, UInt32 value) override {
+        static unsigned logged;
+        bool user = paramName == gIODisplayBrightnessKey, lin = paramName == fLin;
+        if (user || lin) {
+            if (++logged <= 24) BLLOG("backlight: set %s = %u", paramName->getCStringNoCopy(), (unsigned)value);
+            fUi = (SInt32)value;
+            mirror(user ? fLin : gIODisplayBrightnessKey, (SInt32)value);
+            fTarget = (SInt32)value;
+            if (fCall) thread_call_enter(fCall);
+            return true;
+        }
+        if (paramName == fProbe || paramName == fLinProbe) {
+            mirror(paramName == fProbe ? fLinProbe : fProbe, (SInt32)value);
+            return true;
+        }
+        return false;
+    }
+    bool doDataSet(const OSSymbol *, OSData *) override { return false; }
+    bool doUpdate() override { return true; }
+};
+OSDefineMetaClassAndStructors(NVRMBacklightHandler, IODisplayParameterHandler)
+
+void NVRMNVDAFramebuffer::backlightSetup()
+{
+    uint32_t pct = 0;
+    if (gBlNub) return;
+    if (!blApiLoad()) { FBLOG("backlight: NVDSMBacklight resource absent (NVDSM v8 not loaded) -- no brightness control"); return; }
+    IOReturn r = gBlApi.get(&pct);
+    if (r != kIOReturnSuccess) { FBLOG("backlight: NVKMS reports no panel backlight (0x%x)", r); return; }
+    IOService *nub = new IOService;
+    if (!nub || !nub->init()) { OSSafeReleaseNULL(nub); return; }
+    nub->setName("backlight");
+    NVRMBacklightHandler *h = NVRMBacklightHandler::withPercent(pct);
+    if (!h || !nub->attach(getResourceService())) { OSSafeReleaseNULL(h); nub->release(); return; }
+    h->attach(this);   // IODisplay::start searches the framebuffer's subtree (the "backlight" subtree is not searched on 15)
+    h->release();
+    nub->registerService(kIOServiceSynchronous);
+    gBlNub = nub;
+    FBLOG("backlight: panel at %u %%, \"backlight\" service + brightness handler published", pct);
+}
