+static inline void nvu_zero_wide(void *p, size_t n) { size_t q = n >> 3; __asm__ __volatile__("rep stosq" : "+D"(p), "+c"(q) : "a"(0ull) : "memory"); nvu_zero(p, n & 7); }
+static inline void nvu_zero_nt(void *p, size_t n)
+{
+    char *c = (char *)p; const NvU64 z = 0;
+    for (size_t i = n >> 6; i; i--, c += 64)
+        __asm__ __volatile__("movnti %1, 0(%0)\n\tmovnti %1, 8(%0)\n\tmovnti %1, 16(%0)\n\tmovnti %1, 24(%0)\n\t"
+                             "movnti %1, 32(%0)\n\tmovnti %1, 40(%0)\n\tmovnti %1, 48(%0)\n\tmovnti %1, 56(%0)"
+                             : : "r"(c), "r"(z) : "memory");
+    __asm__ __volatile__("sfence" : : : "memory");
+    nvu_zero(c, n & 63);
+}
+// Reads the sampled qwords of a fresh grant; returns how many were nonzero.
+static SInt64 nvrmScrubSample(void *kva, NvU64 n, NvU64 phys)
+{
+    const SInt64 seq = OSAddAtomic64(1, &gScrubChecked);
+    const bool dense = (seq & 255) == 0;
+    const NvU64 step = dense ? 4096 : 65536, start = ((NvU64)seq * 0x9E38ull) & (step - 8);
+    const uint64_t t0 = mach_absolute_time();
+    volatile const NvU64 *q = (volatile const NvU64 *)kva;
+    SInt64 dirty = 0, words = 0; NvU64 firstOff = 0, firstVal = 0;
+    for (NvU64 off = start; off + 8 <= n; off += step, words++) {
+        const NvU64 v = q[off >> 3];
+        if (v && !dirty++) { firstOff = off; firstVal = v; }
+    }
+    const NvU64 v = q[(n >> 3) - 1]; words++;
+    if (v && !dirty++) { firstOff = n - 8; firstVal = v; }
+    OSAddAtomic64((SInt64)(mach_absolute_time() - t0), &gScrubCheckNs); OSAddAtomic64(words, &gScrubWords);
+    if (dense) OSAddAtomic64(1, &gScrubDense);
+    if (dirty) {
+        OSAddAtomic64(1, &gScrubDirty); OSAddAtomic64(dirty, &gScrubDirtyWords);
+        if (dense) OSAddAtomic64(1, &gScrubDenseDirty);
+        gScrubLastDirtyPhys = (SInt64)phys; gScrubLastDirtyOff = (SInt64)firstOff; gScrubLastDirtyVal = (SInt64)firstVal;
+    }
+    return dirty;
+}
+static int nvrmfb_scrubtest_sysctl SYSCTL_HANDLER_ARGS
+{
+    int v = 0; int err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || req->newptr == 0) return err;
+    if (!gFB || v < 1 || v > 32) return EINVAL;
+    static struct NVRMVramRequest a[32], b[32]; static NvU64 ap[32], an[32];
+    int na = 0, nb = 0; gScrubTestGrants = gScrubTestOverlap = gScrubTestDirty = gScrubTestDirtyOverlap = 0;
+    for (; na < v; na++) {
+        struct NVRMVramRequest *r = &a[na]; nvu_zero(r, sizeof *r);
+        r->version = NVRM_VRAM_ABI_VERSION; r->size = 8323072ull;
+        if (!gFB->vramGrant(r)) break;
+        ap[na] = r->phys; an[na] = r->actualSize;
+        NvU64 *w = (NvU64 *)r->kva; size_t qn = (size_t)(r->actualSize >> 3);
+        __asm__ __volatile__("rep stosq" : "+D"(w), "+c"(qn) : "a"(0xA55A5AA5C0DEF00Dull) : "memory");
+    }
+    for (int i = 0; i < na; i++) gFB->vramRelease(&a[i]);
+    for (; nb < na; nb++) {
+        struct NVRMVramRequest *r = &b[nb]; nvu_zero(r, sizeof *r);
+        r->version = NVRM_VRAM_ABI_VERSION; r->size = 8323072ull;
+        gScrubProbeDirty = 0; gScrubProbe = r;
+        const bool ok = gFB->vramGrant(r);
+        gScrubProbe = nullptr;
+        if (!ok) break;
+        bool ov = false;
+        for (int i = 0; i < na; i++) if (r->phys < ap[i] + an[i] && r->phys + r->actualSize > ap[i]) ov = true;
+        gScrubTestGrants++; if (ov) gScrubTestOverlap++;
+        if (gScrubProbeDirty) { gScrubTestDirty++; if (ov) gScrubTestDirtyOverlap++; }
+    }
+    for (int i = 0; i < nb; i++) gFB->vramRelease(&b[i]);
+    kprintf("NVRM-fb: scrubtest: filled %d, regranted %d, overlapping %d, nonzero %d (overlapping and nonzero %d)\n",
+            na, gScrubTestGrants, gScrubTestOverlap, gScrubTestDirty, gScrubTestDirtyOverlap);
+    return 0;
+}
