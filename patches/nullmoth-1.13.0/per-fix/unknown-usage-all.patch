diff --git a/plugin/NVMTLObjects.h b/plugin/NVMTLObjects.h
index 69e07a5..a5cd466 100644
--- a/plugin/NVMTLObjects.h
+++ b/plugin/NVMTLObjects.h
@@ -9,6 +9,26 @@
 #import <Metal/Metal.h>
 #import <IOSurface/IOSurface.h>
 #include "nvmtl_vk.h"
+#include <stdatomic.h>
+
+void nvlog(const char *fmt, ...);
+// Metal: MTLTextureUsageUnknown (0) means "every usage". QuartzCore hands exactly that for a framebufferOnly=NO CAMetalLayer
+// drawable (CAMetalLayer.textureUsage defaults to 0), and Apple's drivers then allow - and report - ShaderRead|ShaderWrite|
+// RenderTarget. We used to read 0 as read-only: usage reported ShaderRead and no storage image was made, so Core Image
+// (Photo Booth live preview, "texture usage must include MTLTextureUsageShaderWrite") and compute kernels writing straight
+// into such a drawable (or into an Unknown-usage texture) wrote nothing. NVMTL_UNKNOWN_USAGE=0 restores the old reading (set it in
+// /Library/GPUBundles/nvmtl/nvrm610.conf: release builds drop NVMTL_* from the environment, see nvmtl_conf_knobs).
+static inline MTLTextureDescriptor *nvmtl_unknown_usage_all(MTLTextureDescriptor *d) {
+    static int off = -1;
+    if (off < 0) { const char *e = getenv("NVMTL_UNKNOWN_USAGE"); off = e && *e == '0'; }
+    if (!d || off || d.usage != MTLTextureUsageUnknown) return d;
+    MTLTextureDescriptor *c = [d copy];
+    c.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsageRenderTarget;
+    static _Atomic unsigned long n; const unsigned long k = atomic_fetch_add(&n, 1) + 1;
+    if (!(k & (k - 1))) nvlog("texture usage Unknown(0) read as ShaderRead|ShaderWrite|RenderTarget like Apple (%lu so far in this process; first: %lux%lu fmt %lu)",
+                              k, (unsigned long)d.width, (unsigned long)d.height, (unsigned long)d.pixelFormat);
+    return c;
+}
 
