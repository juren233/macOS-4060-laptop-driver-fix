+// layout stride/stepFunction/stepRate), converted to the kernel's type and written at that stride.
+typedef struct { uint8_t comps, size, kind, norm, bgra; } nvmtl_si_fmt;   // kind 0 float32, 1 half, 2 sint, 3 uint
+static BOOL nvmtl_si_format(MTLAttributeFormat f, nvmtl_si_fmt *o) {
+    switch (f) {
+#define NVSI(n, c, sz, k, nm, bg) case MTLAttributeFormat##n: *o = (nvmtl_si_fmt){ c, sz, k, nm, bg }; return YES;
