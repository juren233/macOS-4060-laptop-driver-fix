+        NVSI(Short4Normalized, 4, 2, 2, 1, 0)
+        NVSI(Half, 1, 2, 1, 0, 0) NVSI(Half2, 2, 2, 1, 0, 0) NVSI(Half3, 3, 2, 1, 0, 0) NVSI(Half4, 4, 2, 1, 0, 0)
+        NVSI(Float, 1, 4, 0, 0, 0) NVSI(Float2, 2, 4, 0, 0, 0) NVSI(Float3, 3, 4, 0, 0, 0) NVSI(Float4, 4, 4, 0, 0, 0)
+        NVSI(Int, 1, 4, 2, 0, 0) NVSI(Int2, 2, 4, 2, 0, 0) NVSI(Int3, 3, 4, 2, 0, 0) NVSI(Int4, 4, 4, 2, 0, 0)
+        NVSI(UInt, 1, 4, 3, 0, 0) NVSI(UInt2, 2, 4, 3, 0, 0) NVSI(UInt3, 3, 4, 3, 0, 0) NVSI(UInt4, 4, 4, 3, 0, 0)
