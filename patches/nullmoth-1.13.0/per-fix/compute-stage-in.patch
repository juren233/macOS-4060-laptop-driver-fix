+        NVSI(UChar4Normalized, 4, 1, 3, 1, 0) NVSI(UChar4Normalized_BGRA, 4, 1, 3, 1, 1)
+        NVSI(CharNormalized, 1, 1, 2, 1, 0) NVSI(Char2Normalized, 2, 1, 2, 1, 0) NVSI(Char3Normalized, 3, 1, 2, 1, 0)
+        NVSI(Char4Normalized, 4, 1, 2, 1, 0)
+        NVSI(UShort, 1, 2, 3, 0, 0) NVSI(UShort2, 2, 2, 3, 0, 0) NVSI(UShort3, 3, 2, 3, 0, 0) NVSI(UShort4, 4, 2, 3, 0, 0)
+        NVSI(Short, 1, 2, 2, 0, 0) NVSI(Short2, 2, 2, 2, 0, 0) NVSI(Short3, 3, 2, 2, 0, 0) NVSI(Short4, 4, 2, 2, 0, 0)
+        NVSI(UShortNormalized, 1, 2, 3, 1, 0) NVSI(UShort2Normalized, 2, 2, 3, 1, 0) NVSI(UShort3Normalized, 3, 2, 3, 1, 0)
