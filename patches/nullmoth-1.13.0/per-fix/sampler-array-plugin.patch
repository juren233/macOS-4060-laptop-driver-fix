diff --git a/plugin/nvmtl_vk.c b/plugin/nvmtl_vk.c
index 30e1e5c..b1cd2b9 100644
--- a/plugin/nvmtl_vk.c
+++ b/plugin/nvmtl_vk.c
@@ -1945,17 +1945,46 @@ static int nvmtl_spirv_bmask(const void *p, size_t n, uint64_t out[4])
     const uint32_t *w = (const uint32_t *)p; size_t nw = n / 4;
     memset(out, 0, 4 * sizeof *out);
     if (!p || nw < 5 || w[0] != 0x07230203u) return 0;
+    /* A descriptor ARRAY (`sampler2D u_texture[16]`, array<texture2d<float>, 16>) occupies `count` consecutive slots, but its
+       Binding decoration names only the first one: follow variable -> pointer -> array -> length constant so every element's slot
+       gets written. Without this only element 0 ever reached the shader and the others read the dummy descriptor. */
+    const uint32_t bound = w[3];
+    uint32_t *info = (bound && bound <= (1u << 22)) ? (uint32_t *)calloc((size_t)bound * 4, sizeof(uint32_t)) : NULL;
+    enum { VAR_TYPE = 0, PTR_POINTEE = 1, ARR_LEN = 2, CONST_VAL = 3 };
+#define NVMTL_BM_INFO(kind, id) info[(size_t)(id) * 4 + (kind)]
+    if (info) {
+        for (size_t i = 5; i < nw; ) {
+            uint32_t wc = w[i] >> 16, op = w[i] & 0xffffu;
+            if (!wc || i + wc > nw) { free(info); return 0; }
+            if (op == 59 && wc >= 4 && w[i + 2] < bound) NVMTL_BM_INFO(VAR_TYPE, w[i + 2]) = w[i + 1];
+            else if (op == 32 && wc == 4 && w[i + 1] < bound) NVMTL_BM_INFO(PTR_POINTEE, w[i + 1]) = w[i + 3];
+            else if (op == 28 && wc == 4 && w[i + 1] < bound) NVMTL_BM_INFO(ARR_LEN, w[i + 1]) = w[i + 3];
+            else if (op == 43 && wc >= 4 && w[i + 2] < bound) NVMTL_BM_INFO(CONST_VAL, w[i + 2]) = w[i + 3];
+            i += wc;
+        }
+    }
     for (size_t i = 5; i < nw; ) {
         uint32_t wc = w[i] >> 16, op = w[i] & 0xffffu;
-        if (!wc || i + wc > nw) return 0;
+        if (!wc || i + wc > nw) { free(info); return 0; }
         if (op == 71 && wc == 4 && w[i + 2] == 33) {
-            uint32_t b = w[i + 3];
+            uint32_t b = w[i + 3], count = 1;
+            if (info && w[i + 1] < bound) {
+                uint32_t vt = NVMTL_BM_INFO(VAR_TYPE, w[i + 1]);
+                uint32_t pt = vt < bound ? NVMTL_BM_INFO(PTR_POINTEE, vt) : 0;
+                uint32_t len = pt && pt < bound ? NVMTL_BM_INFO(ARR_LEN, pt) : 0;
+                if (len && len < bound) count = NVMTL_BM_INFO(CONST_VAL, len);
+                if (count < 1 || count > NVMTL_NTEX) count = 1;
+            }
             if (b == NVMTL_ADDRESS_BINDING_NUMBER) out[NVMTL_ADDRESS_BINDING >> 6] |= 1ull << (NVMTL_ADDRESS_BINDING & 63);
-            else if (b < NVMTL_ADDRESS_BINDING) out[b >> 6] |= 1ull << (b & 63);
-            else if (!(b >= NVMTL_STEX_BINDING_NUMBER && b < NVMTL_STEX_BINDING_NUMBER + NVMTL_NSTEX)) return 0;
+            else if (b < NVMTL_ADDRESS_BINDING) {
+                for (uint32_t k = 0; k < count && b + k < NVMTL_ADDRESS_BINDING; k++) out[(b + k) >> 6] |= 1ull << ((b + k) & 63);
+            }
+            else if (!(b >= NVMTL_STEX_BINDING_NUMBER && b < NVMTL_STEX_BINDING_NUMBER + NVMTL_NSTEX)) { free(info); return 0; }
         }
         i += wc;
     }
+#undef NVMTL_BM_INFO
+    free(info);
     return 1;
 }
 enum { NVMTL_SLOT_NONE = 0, NVMTL_SLOT_BUF, NVMTL_SLOT_TEX, NVMTL_SLOT_SAMP, NVMTL_SLOT_TEXBUF  };
