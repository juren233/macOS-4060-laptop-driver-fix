+/* ===== LOCAL-FIX (this Hackintosh, RTX 4060 / macOS 15): persistent VkPipelineCache
+ * DO NOT REMOVE, REVERT OR 'SIMPLIFY' when merging upstream NullMoth changes - without it every boot recompiles all NVK shaders and WindowServer sits at ~100% CPU for minutes after login.
+ * History: git log in ~/work/nvidia-setup/src/repo (branch local-mods). Installed + guarded by ~/work/system/nvguard. ===== */
+/* Persistent VkPipelineCache: every NVK shader compile (NIR -> NAK) used to be redone from scratch on every boot, because pipelines were
+ * created with VK_NULL_HANDLE.  WindowServer alone spent most of its first minutes after login in nvk_compile_shaders.  The cache lives next
+ * to the SPIR-V cache, is keyed by the Vulkan driver build (size+mtime), and is merged with what other processes of the same user stored. */
+static VkPipelineCache g_pcache;
+static char g_pcache_path[1024];
+static _Atomic unsigned g_pcache_gen, g_pcache_saved;
+static _Atomic int g_pcache_timer;
+static size_t g_pcache_lastsz;
+#define NVMTL_PCACHE_MAX (512ull << 20)
+
+static void *nvmtl_pcache_read(const char *path, size_t *n)
+{
+    int fd = open(path, O_RDONLY | O_CLOEXEC); if (fd < 0) return NULL;
+    struct stat st; void *buf = NULL;
+    if (fstat(fd, &st) == 0 && st.st_size > 32 && (unsigned long long)st.st_size <= NVMTL_PCACHE_MAX && (buf = malloc((size_t)st.st_size))) {
+        size_t got = 0;
+        while (got < (size_t)st.st_size) { ssize_t r = read(fd, (char *)buf + got, (size_t)st.st_size - got); if (r <= 0) break; got += (size_t)r; }
+        if (got != (size_t)st.st_size) { free(buf); buf = NULL; } else *n = got;
+    }
+    close(fd);
+    return buf;
+}
+
+static void nvmtl_pcache_save_now(void)
+{
+    if (!g_pcache || !g_pcache_path[0]) return;
+    const unsigned gen = atomic_load(&g_pcache_gen);
+    if (gen == atomic_load(&g_pcache_saved)) return;
+    { size_t cur = 0;   /* creating a pipeline that was already in the cache does not grow it - nothing new to persist */
+      if (pvkGetPipelineCacheData(g_dev, g_pcache, &cur, NULL) == VK_SUCCESS && cur == g_pcache_lastsz) { atomic_store(&g_pcache_saved, gen); return; }
+      g_pcache_lastsz = cur; }
+    VkPipelineCache out = g_pcache, tmp = VK_NULL_HANDLE;
+    size_t on = 0; void *old = nvmtl_pcache_read(g_pcache_path, &on);
+    if (old) {
+        VkPipelineCacheCreateInfo ci = { VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO, NULL, 0, on, old };
+        if (pvkCreatePipelineCache(g_dev, &ci, NULL, &tmp) == VK_SUCCESS) {
+            if (pvkMergePipelineCaches(g_dev, tmp, 1, &g_pcache) == VK_SUCCESS) out = tmp;
+            else { pvkDestroyPipelineCache(g_dev, tmp, NULL); tmp = VK_NULL_HANDLE; }
+        }
+        free(old);
+    }
+    size_t sz = 0;
+    if (pvkGetPipelineCacheData(g_dev, out, &sz, NULL) == VK_SUCCESS && sz > 32 && sz <= NVMTL_PCACHE_MAX) {
+        void *buf = malloc(sz);
+        if (buf && pvkGetPipelineCacheData(g_dev, out, &sz, buf) == VK_SUCCESS) {
+            char tp[1100]; snprintf(tp, sizeof tp, "%s.%d.tmp", g_pcache_path, (int)getpid());
+            int fd = open(tp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+            if (fd >= 0) {
+                size_t put = 0;
+                while (put < sz) { ssize_t w = write(fd, (char *)buf + put, sz - put); if (w <= 0) break; put += (size_t)w; }
+                close(fd);
+                if (put == sz && rename(tp, g_pcache_path) == 0) { atomic_store(&g_pcache_saved, gen); nvlog("pcache: saved %zu KiB to %s", sz >> 10, g_pcache_path); }
+                else unlink(tp);
+            }
+        }
+        free(buf);
+    }
+    if (tmp) pvkDestroyPipelineCache(g_dev, tmp, NULL);
+}
+
+static void nvmtl_pcache_rearm(void);
+static void nvmtl_pcache_touch(void)
+{
+    atomic_fetch_add(&g_pcache_gen, 1);
+    if (atomic_exchange(&g_pcache_timer, 1)) return;
+    nvmtl_pcache_rearm();
+}
+
+static void nvmtl_pcache_rearm(void)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        atomic_store(&g_pcache_timer, 0);
+        nvmtl_pcache_save_now();
+        if (atomic_load(&g_pcache_gen) != atomic_load(&g_pcache_saved) && g_pcache_path[0] && !atomic_exchange(&g_pcache_timer, 1)) nvmtl_pcache_rearm();
+    });
+}
