+++ b/plugin/nvmtl_si_gather_air.h
@@ -0,0 +1,333 @@
+/*
+ * Compute stage_in gather kernel: AIR text built from si_gather.metal with
+ *   xcrun -sdk macosx metal -c si_gather.metal -o si_gather.air; air-opt -S si_gather.air -o si_gather.ll
+ * (so building the plugin needs no Metal toolchain). Any MTLAttributeFormat of 8/16/32-bit components (float, half,
+ * signed/unsigned, normalized, BGRA) -> the kernel-side value (float/half/int/uint x 1..4 lanes) at the translator's
+ * stage_in element stride. Buffers: src 28, dst 29, params 30 (SIP, 16 words).
+ */
+static const char nvmtl_si_gather_ll[] =
+    "; ModuleID = 'si_gather.air'\n"
+    "source_filename = \"si_gather.metal\"\n"
+    "target datalayout = \"e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32\"\n"
+    "target triple = \"air64_v27-apple-macosx15.0.0\"\n"
+    "\n"
+    "%struct.SIP = type { i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32 }\n"
+    "\n"
+    "; Function Attrs: argmemonly mustprogress nofree nosync nounwind\n"
+    "define void @nvmtl_si_gather(i32 noundef %0, i8 addrspace(1)* nocapture noundef readonly \"air-buffer-no-alias\" %1, i8 addrspace(1)* nocapture noundef writeonly \"air-buffer-no-alias\" %2, %struct.SIP addrspace(2)* nocapture noundef readonly align 4 dereferenceable(64) \"air-buffer-no-alias\" %3) local_unnamed_addr #0 {\n"
+    "  %5 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 0\n"
+    "  %6 = load i32, i32 addrspace(2)* %5, align 4, !tbaa !24, !alias.scope !29, !noalias !32\n"
+    "  %7 = icmp ugt i32 %6, %0\n"
+    "  br i1 %7, label %166, label %8\n"
+    "\n"
+    "8:                                                ; preds = %4\n"
+    "  %9 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 1\n"
+    "  %10 = load i32, i32 addrspace(2)* %9, align 4, !tbaa !35, !alias.scope !29, !noalias !32\n"
+    "  %11 = icmp ugt i32 %10, %0\n"
+    "  br i1 %11, label %12, label %166\n"
+    "\n"
+    "12:                                               ; preds = %8\n"
+    "  %13 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 6\n"
+    "  %14 = load i32, i32 addrspace(2)* %13, align 4, !tbaa !36, !alias.scope !29, !noalias !32\n"
+    "  %15 = icmp eq i32 %14, 0\n"
+    "  br i1 %15, label %16, label %20\n"
+    "\n"
+    "16:                                               ; preds = %12\n"
+    "  %17 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 4\n"
+    "  %18 = load i32, i32 addrspace(2)* %17, align 4, !tbaa !37, !alias.scope !29, !noalias !32\n"
+    "  %19 = udiv i32 %0, %18\n"
+    "  br label %20\n"
+    "\n"
+    "20:                                               ; preds = %16, %12\n"
+    "  %21 = phi i32 [ %19, %16 ], [ 0, %12 ]\n"
+    "  %22 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 2\n"
+    "  %23 = load i32, i32 addrspace(2)* %22, align 4, !tbaa !38, !alias.scope !29, !noalias !32\n"
+    "  %24 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 3\n"
+    "  %25 = load i32, i32 addrspace(2)* %24, align 4, !tbaa !39, !alias.scope !29, !noalias !32\n"
+    "  %26 = mul i32 %25, %21\n"
+    "  %27 = add i32 %26, %23\n"
+    "  %28 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 8\n"
+    "  %29 = load i32, i32 addrspace(2)* %28, align 4, !tbaa !40, !alias.scope !29, !noalias !32\n"
+    "  %30 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 9\n"
+    "  %31 = load i32, i32 addrspace(2)* %30, align 4, !tbaa !41, !alias.scope !29, !noalias !32\n"
+    "  %32 = mul i32 %31, %29\n"
+    "  %33 = add i32 %32, %27\n"
+    "  %34 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 5\n"
+    "  %35 = load i32, i32 addrspace(2)* %34, align 4, !tbaa !42, !alias.scope !29, !noalias !32\n"
+    "  %36 = icmp ugt i32 %33, %35\n"
+    "  br i1 %36, label %166, label %37\n"
+    "\n"
+    "37:                                               ; preds = %20\n"
+    "  %38 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 7\n"
+    "  %39 = load i32, i32 addrspace(2)* %38, align 4, !tbaa !43, !alias.scope !29, !noalias !32\n"
+    "  %40 = mul i32 %39, %0\n"
+    "  %41 = zext i32 %40 to i64\n"
+    "  %42 = getelementptr inbounds i8, i8 addrspace(1)* %2, i64 %41\n"
+    "  %43 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 13\n"
+    "  %44 = load i32, i32 addrspace(2)* %43, align 4, !tbaa !44, !alias.scope !29, !noalias !32\n"
+    "  %45 = getelementptr inbounds %struct.SIP, %struct.SIP addrspace(2)* %3, i64 0, i32 12\n"
+    "  %46 = load i32, i32 addrspace(2)* %45, align 4\n"
