diff --git a/plugin/si_gather.metal b/plugin/si_gather.metal
new file mode 100644
index 0000000..b116a44
--- /dev/null
+++ b/plugin/si_gather.metal
@@ -0,0 +1,56 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// Compute stage_in gather: one vertex attribute of any MTLAttributeFormat -> the translator's stage_in buffer
+// (kernel value type lanes/kind, element stride dstBytes). Buffers: src 28, dst 29, params 30.
+struct SIP {
+    uint lo, hi, srcBase, stride, rate, srcLimit, isConst, dstBytes;
+    uint comps, csize, kind, norm, bgra, dl, dk, pad;   // source comps/size/kind(0 f32,1 half,2 sint,3 uint)/normalized/bgra; dest lanes/kind(0 f,1 h,2 i,3 u)
+};
+
+static uint ld(device const uchar *p, uint size) {
+    uint v = p[0];
+    if (size > 1) v |= uint(p[1]) << 8;
+    if (size > 2) v |= (uint(p[2]) << 16) | (uint(p[3]) << 24);
+    return v;
+}
+
+kernel void nvmtl_si_gather(uint tid [[thread_position_in_grid]],
+                            device const uchar *src [[buffer(28)]],
+                            device uchar *dst [[buffer(29)]],
+                            constant SIP &p [[buffer(30)]])
+{
+    if (tid < p.lo || tid >= p.hi) return;
+    const uint si = p.isConst ? 0u : tid / p.rate;
+    const uint at = p.srcBase + si * p.stride;
+    if (at + p.comps * p.csize > p.srcLimit) return;
+    device uchar *out = dst + tid * p.dstBytes;
+    for (uint j = 0; j < 4; j++) {
+        if (j >= p.dl) break;
+        float fv = (j == 3) ? 1.0f : 0.0f;
+        int iv = (j == 3) ? 1 : 0;
+        uint uv = (j == 3) ? 1u : 0u;
+        if (j < p.comps) {
+            const uint k = p.bgra ? (j == 0 ? 2u : (j == 2 ? 0u : j)) : j;
+            const uint raw = ld(src + at + k * p.csize, p.csize);
+            if (p.kind == 0) { fv = as_type<float>(raw); iv = int(fv); uv = uint(fv); }
+            else if (p.kind == 1) { fv = float(as_type<half>(ushort(raw))); iv = int(fv); uv = uint(fv); }
+            else if (p.kind == 2) {
+                const uint sh = 32u - p.csize * 8u;
+                iv = int(raw << sh) >> sh;
+                uv = uint(iv);
+                const float mx = float((1u << (p.csize * 8u - 1u)) - 1u);
+                fv = p.norm ? max(float(iv) / mx, -1.0f) : float(iv);
+            } else {
+                uv = raw; iv = int(raw);
+                const float mx = p.csize == 4 ? 4294967295.0f : float((1u << (p.csize * 8u)) - 1u);
+                fv = p.norm ? float(raw) / mx : float(raw);
+            }
+            if (p.kind < 2) { /* float source: integer dests convert the value */ }
+        }
+        if (p.dk == 0) *(device uint *)(out + j * 4) = as_type<uint>(fv);
+        else if (p.dk == 1) *(device ushort *)(out + j * 2) = as_type<ushort>(half(fv));
+        else if (p.dk == 2) *(device int *)(out + j * 4) = iv;
+        else *(device uint *)(out + j * 4) = uv;
+    }
+}
