+// IOSurface diagnostics that reach the system log even in a release build (tag "NullMoth-diag"), plus a per-surface record
+// of this process's GPU writes so a surface-in can tell when the shared VRAM is about to receive newer GPU contents.
+#pragma once
+#include <syslog.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <os/lock.h>
+#include <time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/time.h>
+#include <stdlib.h>
+static void nvdiag_emit(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvdiag_emit(const char *fmt, ...) {
+    char b[600]; va_list a; va_start(a, fmt); vsnprintf(b, sizeof b, fmt, a); va_end(a);
+    syslog(LOG_ERR, "NullMoth-diag: %s", b);
+}
+#define NVDIAG(lim, ...) do { static _Atomic unsigned nvd_c_; const unsigned nvd_k_ = atomic_fetch_add(&nvd_c_, 1); \
+    if (nvd_k_ < (unsigned)(lim) || !(nvd_k_ % 2000)) nvdiag_emit(__VA_ARGS__); } while (0)
+#define NVSD_N 4096
+static struct { uint32_t id; uint64_t dirty, out; uint32_t dn, on; uintptr_t ws; } g_nvsd[NVSD_N];
+static os_unfair_lock g_nvsd_l = OS_UNFAIR_LOCK_INIT;
+static int nvsd_slot(uint32_t id) {
+    const unsigned h = (id * 2654435761u) % NVSD_N;
+    for (unsigned k = 0; k < 32; k++) { const unsigned i = (h + k) % NVSD_N; if (g_nvsd[i].id == id || !g_nvsd[i].id) return (int)i; }
+    return (int)h;
+}
+// what: 0 = a GPU write was encoded, 1 = the writes were published (surface-out after completion).
+// ws (what 0): where the write lands - NVSD_WS_VRAM for the surface's shared VRAM, else the private image's root texture.
+#define NVSD_WS_VRAM ((uintptr_t)1)
+static void nvsd_mark(uint32_t id, int what, uintptr_t ws) {
+    if (!id) return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id);
+    if (g_nvsd[i].id != id) { g_nvsd[i].id = id; g_nvsd[i].dirty = g_nvsd[i].out = 0; g_nvsd[i].dn = g_nvsd[i].on = 0; g_nvsd[i].ws = 0; }
+    // Counted, not timestamped: a publish of frame N that lands after frame N+1 was encoded must not hide N+1's write.
+    if (what) { g_nvsd[i].out = now; if (g_nvsd[i].on < g_nvsd[i].dn) g_nvsd[i].on++; }
+    else { g_nvsd[i].dirty = now; g_nvsd[i].dn++; g_nvsd[i].ws = ws; }
+    os_unfair_lock_unlock(&g_nvsd_l);
+}
+static int nvsd_pending(uint32_t id) {
+    if (!id) return 0;
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id); const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    // The age limit keeps a write that is never published (command buffer dropped) from blocking uploads for good.
+    const int p = g_nvsd[i].id == id && g_nvsd[i].dn > g_nvsd[i].on && now - g_nvsd[i].dirty < 500000000ull;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    return p;
+}
+// Where this process's newest encoded write to the surface lands (nvsd_mark's ws), 0 when unknown.
+static uintptr_t nvsd_writer(uint32_t id) {
+    if (!id) return 0;
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id); const uintptr_t ws = g_nvsd[i].id == id ? g_nvsd[i].ws : 0;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    return ws;
+}
+// Cross-process GPU-write tracking. A producer (Chrome's GPU process, gfx4's producer) commits writes to an IOSurface and,
+// with NVMTL_SCHEDULED_WAIT=0, hands the surface over as soon as they are submitted. On Apple GPUs the consumer's later work is
+// ordered after them; here every process has its own GPU channel, and a private image's writes reach the surface's pages
+// only at the surface-out after completion. The consumer read the previous frame (catest/gfx4: 1-53 of 60 frames wrong).
+// The g_nvsd counters (encoded / published writes) are mirrored into the surface as value "NVMTLWr:p<plane>" (visible to
+// every process as soon as IOSurfaceSetValue returns), and a consumer waits for another process's unpublished writes
+// before it uses the surface. How depends on where the writer's texture keeps its pixels (flag NVMTL_XWR_VRAM): a writer
+// drawing into the shared VRAM leaves its result there, so a reader over that VRAM skips the page upload and waits before
+// submission (the GPU reads the VRAM); a writer with a private image publishes through the surface's pages, so every reader
+// waits at surface-in, where the upload decision reads them (catest/gfx4: producer private, consumer over shared VRAM).
+// NVMTL_XSURF_SYNC=0: off.
+#define NVMTL_XWR_MAGIC 0x3257564eu   /* "NVW2" */
+#define NVMTL_XWR_VRAM 1u
+typedef struct { uint32_t magic, pid, dn, on, flags, pad; uint64_t dirty; } nvmtl_xwr;
+static os_unfair_lock g_xwr_l = OS_UNFAIR_LOCK_INIT;
+static _Atomic unsigned long long g_xwr_waits, g_xwr_wait_ns, g_xwr_timeouts;
+static int nvmtl_xsync_trace(void) { static int on = -1; if (on < 0) { const char *e = getenv("NVMTL_XSYNC_TRACE"); on = e && *e == '1'; } return on; }
+static int nvmtl_xsync_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_XSURF_SYNC"); on = !(e && e[0] == '0');
+        nvdiag_emit("cross-process IOSurface sync %s (NVMTL_XSURF_SYNC=%s): a surface another process has unpublished GPU writes to is %s",
+                    on ? "ON" : "off", e ? e : "unset", on ? "used only after they are published" : "used at once"); }
+    return on;
+}
+static CFStringRef nvmtl_xwr_key(NSUInteger plane) {
+    static CFStringRef keys[4]; static dispatch_once_t once;
+    dispatch_once(&once, ^{ for (unsigned long i = 0; i < 4; i++) keys[i] = CFStringCreateWithFormat(NULL, NULL, CFSTR("NVMTLWr:p%lu"), i); });
+    if (plane < 4) return CFRetain(keys[plane]);
+    return CFStringCreateWithFormat(NULL, NULL, CFSTR("NVMTLWr:p%lu"), (unsigned long)plane);
+}
+// After nvsd_mark(id, ...): store this process's current counters for the plane in the surface. The snapshot is taken under
+// g_xwr_l, so the value written last always holds the newest counters.
+static void nvmtl_xwr_note(IOSurfaceRef surf, NSUInteger plane, uint32_t id, BOOL vram) {
+    if (!surf || !id || !nvmtl_xsync_on()) return;
+    os_unfair_lock_lock(&g_xwr_l);
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id);
+    const nvmtl_xwr w = { NVMTL_XWR_MAGIC, (uint32_t)getpid(), g_nvsd[i].dn, g_nvsd[i].on, vram ? NVMTL_XWR_VRAM : 0u, 0, g_nvsd[i].dirty };
+    const int valid = g_nvsd[i].id == id;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    if (valid) {
+        CFDataRef d = CFDataCreate(NULL, (const UInt8 *)&w, sizeof w); CFStringRef k = nvmtl_xwr_key(plane);
+        IOSurfaceSetValue(surf, k, d); CFRelease(k); CFRelease(d);
+    }
+    if (nvmtl_xsync_trace()) fprintf(stderr, "xsync %d NOTE surf %u dn %u on %u vram %d%s\n", getpid(), (unsigned)IOSurfaceGetID(surf), w.dn, w.on, vram, valid ? "" : " (slot lost)");
+    os_unfair_lock_unlock(&g_xwr_l);
+}
+// Another process's encoded-but-unpublished writes to the plane: the count to wait for (0 = none). Entries older than 500 ms
+// are ignored like nvsd_pending's (a command buffer that was dropped or failed publishes nothing).
+static uint32_t nvmtl_xwr_pending(IOSurfaceRef surf, NSUInteger plane, uint32_t *pid, uint32_t *flags) {
+    if (!surf || !nvmtl_xsync_on()) return 0;
+    CFStringRef k = nvmtl_xwr_key(plane); CFTypeRef v = IOSurfaceCopyValue(surf, k); CFRelease(k);
+    nvmtl_xwr w = { 0 };
+    const int ok = v && CFGetTypeID(v) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)v) == (CFIndex)sizeof w;
+    if (ok) memcpy(&w, CFDataGetBytePtr((CFDataRef)v), sizeof w);
+    if (v) CFRelease(v);
+    if (!ok || w.magic != NVMTL_XWR_MAGIC || w.pid == (uint32_t)getpid() || w.dn <= w.on
+        || clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - w.dirty > 500000000ull) return 0;
+    if (pid) *pid = w.pid;
+    if (flags) *flags = w.flags;
+    return w.dn;
+}
+// Wait until the writes pending now are published (not later ones: a producer rewriting the surface must not keep us waiting),
+// the writer changes, or 200 ms pass (a cross-process event the writer waits on could otherwise deadlock us).
+static void nvmtl_xwr_wait(IOSurfaceRef surf, NSUInteger plane, const char *who) {
+    uint32_t wpid = 0; const uint32_t target = nvmtl_xwr_pending(surf, plane, &wpid, NULL);
+    if (nvmtl_xsync_trace()) fprintf(stderr, "xsync %d CHECK %s surf %u target %u\n", getpid(), who, (unsigned)IOSurfaceGetID(surf), target);
+    if (!target) return;
+    const uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    CFStringRef k = nvmtl_xwr_key(plane); int timedout = 0;
+    for (unsigned polls = 0;; polls++) {
+        usleep(polls < 50 ? 20 : 100);
+        CFTypeRef v = IOSurfaceCopyValue(surf, k); nvmtl_xwr w = { 0 };
+        const int ok = v && CFGetTypeID(v) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)v) == (CFIndex)sizeof w;
+        if (ok) memcpy(&w, CFDataGetBytePtr((CFDataRef)v), sizeof w);
+        if (v) CFRelease(v);
+        if (!ok || w.magic != NVMTL_XWR_MAGIC || w.pid != wpid || w.on >= target || w.dn < target) break;
+        if (kill((pid_t)wpid, 0) && errno == ESRCH) break;   // the writer is gone; nothing will publish (EPERM = alive, sandboxed)
+        if (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0 > 200000000ull) { timedout = 1; break; }
+    }
+    CFRelease(k);
+    const uint64_t dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0;
+    const unsigned long long n = atomic_fetch_add(&g_xwr_waits, 1) + 1; atomic_fetch_add(&g_xwr_wait_ns, dt);
+    if (timedout) atomic_fetch_add(&g_xwr_timeouts, 1);
+    if (timedout || !(n & (n - 1)) || !(n % 5000))
+        nvdiag_emit("cross-process sync (%s): surf %u plane %lu waited %.2f ms for pid %u's GPU writes%s - %llu waits, %.1f ms total, %llu timeouts",
+                    who, (unsigned)IOSurfaceGetID(surf), (unsigned long)plane, dt / 1e6, wpid, timedout ? " - TIMED OUT, used anyway" : "",
+                    n, atomic_load(&g_xwr_wait_ns) / 1e6, (unsigned long long)atomic_load(&g_xwr_timeouts));
+}
+static int nvsd_guard_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_SURFIN_GUARD"); on = !(e && e[0] == '0');
+        nvdiag_emit("surface-in guard %s (NVMTL_SURFIN_GUARD=%s): a texture over shared IOSurface VRAM that this process has GPU writes "
+                    "in flight for does %s upload the surface's CPU pages over it", on ? "ON" : "off", e ? e : "unset", on ? "NOT" : "still"); }
+    return on;
+}
+
+// Window-sized shared-VRAM IOSurfaces (>= NVMTL_SURF_SHARE_MINPX pixels, below the 7.2M-pixel scan-out framebuffers): every
+// event on them goes to /private/var/tmp/nvmtl-big.log (not the system log: its per-call-site caps were used up at boot).
+// The budget is per process; the draw trace spends ~7 lines per draw, and the post-login window churn alone ran at ~4000
+// lines/s, so the cap must be large enough to survive a login burst plus the repro. With the trace switch absent nothing
+// is written and nothing is consumed, so the budget only ever burns while a repro is actually running.
+#define NVBIG_RANGE(w, h) ((unsigned long)(w) * (unsigned long)(h) >= 3000000ul && (unsigned long)(w) * (unsigned long)(h) < 7000000ul)
+#define NVBIG_BUDGET 2000000u
+static void nvbig(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvbig(const char *fmt, ...) {
+    static _Atomic unsigned n; static int fd = -2;
+    static _Atomic uint64_t gate_at; static _Atomic int gate_on;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= atomic_load_explicit(&gate_at, memory_order_relaxed)) {
+        atomic_store_explicit(&gate_at, now + 250000000ull, memory_order_relaxed);
+        atomic_store_explicit(&gate_on, access("/private/var/tmp/nvmtl-trace-request", F_OK) == 0, memory_order_relaxed);
+    }
+    if (!atomic_load_explicit(&gate_on, memory_order_relaxed)) return;
+    if (atomic_fetch_add(&n, 1) >= NVBIG_BUDGET) return;
+    if (fd == -2) fd = open("/private/var/tmp/nvmtl-big.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
+    if (fd < 0) return;
+    char b[700]; struct timeval tv; gettimeofday(&tv, NULL); struct tm tm; time_t t = tv.tv_sec; localtime_r(&t, &tm);
+    int k = snprintf(b, sizeof b, "%02d:%02d:%02d.%03d %s[%d] ", tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000), getprogname(), (int)getpid());
+    va_list a; va_start(a, fmt); k += vsnprintf(b + k, sizeof b - (size_t)k - 2, fmt, a); va_end(a);
+    if (k > (int)sizeof b - 2) k = (int)sizeof b - 2;
+    b[k++] = '\n'; (void)!write(fd, b, (size_t)k);
+}
