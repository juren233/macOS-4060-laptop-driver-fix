+    } else {
+        const uint64_t c0 = mach_absolute_time();
+        nvu_zero_wide(kva, (size_t)want);
+        OSAddAtomic64((SInt64)(mach_absolute_time() - c0), &gClearNs); OSAddAtomic64((SInt64)want, &gClearBytes);
