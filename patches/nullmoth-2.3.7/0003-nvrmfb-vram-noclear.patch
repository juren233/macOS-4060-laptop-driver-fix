     sysctl_register_oid(&sysctl__debug_nvrmfb_flip_latch_late);
+    sysctl_register_oid(&sysctl__debug_nvrmfb_clear_mode); sysctl_register_oid(&sysctl__debug_nvrmfb_scrub_checked);
+    sysctl_register_oid(&sysctl__debug_nvrmfb_scrub_dirty); sysctl_register_oid(&sysctl__debug_nvrmfb_clear_skipped);
+    sysctl_register_oid(&sysctl__debug_nvrmfb_clear_skipped_bytes); sysctl_register_oid(&sysctl__debug_nvrmfb_clear_ns);
+    sysctl_register_oid(&sysctl__debug_nvrmfb_clear_bytes);
