+// LOCAL: RM scrubs video memory when it is freed (PMA scrub-on-free, a copy-engine job), so a fresh grant already reads zero
+// and the CPU clear below only repeats it over BAR1 (measured 2026-10-13 on 1.9.0: 0 nonzero in ~21k grants, ~10% of a core
+// under Bilibili danmaku). vramGrant reads one qword per 64 KB (one per 4 KB on every 256th grant) and clears only when one
+// is nonzero. debug.nvrmfb_clear_mode: 2 (default) = skip the clear when every sampled qword is zero, 0 = always clear (upstream).
+static int gClearMode = 2;
+static volatile SInt64 gScrubChecked, gScrubDirty, gClearSkipped, gClearSkippedBytes, gClearNs, gClearBytes;
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_clear_mode, CTLFLAG_RW | CTLFLAG_LOCKED, &gClearMode, 0, "0 always clear, 2 skip when sampled zero");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_scrub_checked, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gScrubChecked, "grants sampled before the clear");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_scrub_dirty, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gScrubDirty, "grants with a nonzero sampled qword");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_clear_skipped, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gClearSkipped, "grants not cleared (mode 2)");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_clear_skipped_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gClearSkippedBytes, "bytes not cleared (mode 2)");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_clear_ns, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gClearNs, "ns spent in the CPU clear");
+SYSCTL_QUAD(_debug, OID_AUTO, nvrmfb_clear_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, (SInt64 *)&gClearBytes, "bytes cleared by the CPU");
+// Reads the sampled qwords of a fresh grant; true if one was nonzero.
+static bool nvrmScrubDirty(void *kva, NvU64 n)
+{
+    const SInt64 seq = OSAddAtomic64(1, &gScrubChecked);
+    const NvU64 step = (seq & 255) == 0 ? 4096 : 65536, start = ((NvU64)seq * 0x9E38ull) & (step - 8);
+    volatile const NvU64 *q = (volatile const NvU64 *)kva;
+    bool dirty = q[(n >> 3) - 1] != 0;
+    for (NvU64 off = start; !dirty && off + 8 <= n; off += step) dirty = q[off >> 3] != 0;
+    if (dirty) OSAddAtomic64(1, &gScrubDirty);
+    return dirty;
+}
