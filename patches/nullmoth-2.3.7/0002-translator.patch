index 0000000..a58823f
--- /dev/null
+++ b/translator/translator/src/passes/descriptor_array_split.rs
@@ -0,0 +1,609 @@
+//! Splits descriptor arrays of textures and samplers into single descriptors.
+//!
+//! A Metal `array<texture2d<float>, N> [[texture(k)]]` (or `array<sampler, N>`) occupies the N
+//! consecutive Metal slots k..k+N-1, and the translator declares it as one UniformConstant
+//! `OpTypeArray<E, N>` at the binding of slot k. The plugin's descriptor set layout, however, has one
+//! binding per Metal slot, each with descriptorCount 1. Indexing past element 0 of such a variable
+//! is undefined in Vulkan: it only worked because NVK happens to lay consecutive bindings out
+//! back to back. With robustBufferAccess on, NVK clamps descriptor array indices to the binding's
+//! own count, so every element read as element 0 (xterm.js's 16 glyph atlas pages all sampled page 0).
+//!
+//! This pass makes the module match the layout: element k becomes its own variable at binding
+//! base + k.
+//!  * A constant index (all ANGLE/WebGL shaders: GLSL ES 3.0 allows only constant sampler indices)
+//!    names that variable directly.
+//!  * A dynamic index replays each consumer (a sample, fetch, read or query) once per element and
+//!    selects the result by `index == k`. Image values cannot be selected or phi'd in Vulkan
+//!    SPIR-V, the result of the consumer can. Every replay runs in the original control flow, so
+//!    implicit-LOD derivatives stay defined.
+//!
+//! The rewrite is all or nothing per module: if any use of a candidate array falls outside these
+//! shapes (an image write through a dynamic element, an element passed through a copy or a phi, two
+//! different dynamic indices feeding one sample), the module is left unchanged.
+use crate::spirv_module::{Instruction, Module, Operand};
+use spirv::{Decoration, Op, StorageClass, Word};
+use std::collections::{HashMap, HashSet};
+
+const INTERFACE_START: usize = 3;
+
+struct ArrayVar {
+    elem_ptr_ty: Word,
+    elem_ty: Word,
+    len: u32,
+    binding: u32,
+    elems: Vec<Word>,
+}
+
+/// Where a consumer gets one of its descriptor operands from.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Source {
+    /// An id that stays as it is.
+    Fixed(Word),
+    /// `OpLoad (OpAccessChain array index)` with a non-constant index.
+    Dynamic { array: Word, index: Word },
+}
+
+/// One instruction that consumes an image (operand 0) or a sampled image built from a dynamic element.
+struct Replay {
+    function: usize,
+    block: usize,
+    consumer: Instruction,
+    image: Source,
+    /// Some((sampled image type, sampler source)) when the consumer samples through OpSampledImage.
+    sampled: Option<(Word, Source)>,
+}
+
+fn is_direct_image_consumer(op: Op) -> bool {
+    matches!(
+        op,
+        Op::ImageFetch
+            | Op::ImageRead
+            | Op::ImageQuerySize
+            | Op::ImageQuerySizeLod
+            | Op::ImageQueryLevels
+            | Op::ImageQuerySamples
+            | Op::ImageSparseFetch
+            | Op::ImageSparseRead
+    )
+}
+
+fn is_sampling_consumer(op: Op) -> bool {
+    matches!(
+        op,
+        Op::ImageSampleImplicitLod
+            | Op::ImageSampleExplicitLod
+            | Op::ImageSampleDrefImplicitLod
+            | Op::ImageSampleDrefExplicitLod
+            | Op::ImageSampleProjImplicitLod
+            | Op::ImageSampleProjExplicitLod
+            | Op::ImageSampleProjDrefImplicitLod
+            | Op::ImageSampleProjDrefExplicitLod
+            | Op::ImageGather
+            | Op::ImageDrefGather
+            | Op::ImageQueryLod
+            | Op::ImageSparseSampleImplicitLod
+            | Op::ImageSparseSampleExplicitLod
+            | Op::ImageSparseSampleDrefImplicitLod
+            | Op::ImageSparseSampleDrefExplicitLod
+            | Op::ImageSparseGather
+            | Op::ImageSparseDrefGather
+    )
+}
+
+fn id_at(instruction: &Instruction, operand: usize) -> Option<Word> {
+    match instruction.operands.get(operand)? {
+        Operand::IdRef(id) => Some(*id),
+        _ => None,
+    }
+}
+
+fn literal_u32(instruction: &Instruction, operand: usize) -> Option<u32> {
+    match instruction.operands.get(operand)? {
+        Operand::LiteralBit32(value) => Some(*value),
+        _ => None,
+    }
+}
+
+/// Integer constants: id -> value (scalar OpConstant of an OpTypeInt only).
+fn int_constants(module: &Module, defs: &HashMap<Word, Instruction>) -> HashMap<Word, u64> {
+    module
+        .types_global_values
+        .iter()
+        .filter(|i| i.class.opcode == Op::Constant)
+        .filter_map(|i| {
+            let ty = defs.get(&i.result_type?)?;
+            if ty.class.opcode != Op::TypeInt {
+                return None;
+            }
+            let value = match i.operands.first()? {
+                Operand::LiteralBit32(v) => *v as u64,
+                Operand::LiteralBit64(v) => *v,
+                _ => return None,
+            };
+            Some((i.result_id?, value))
+        })
+        .collect()
+}
+
+pub(crate) fn split_descriptor_arrays(module: &mut Module) -> bool {
+    let defs: HashMap<Word, Instruction> = module
+        .types_global_values
+        .iter()
+        .filter_map(|i| Some((i.result_id?, i.clone())))
+        .collect();
+    let constants = int_constants(module, &defs);
+
+    // Candidates: UniformConstant variables of array<image | sampler | sampled image, N> with a Binding.
+    let bindings: HashMap<Word, u32> = module
+        .annotations
+        .iter()
+        .filter(|i| {
+            i.class.opcode == Op::Decorate
+                && i.operands.get(1) == Some(&Operand::Decoration(Decoration::Binding))
+        })
+        .filter_map(|i| Some((id_at(i, 0)?, literal_u32(i, 2)?)))
+        .collect();
+    let mut arrays: HashMap<Word, ArrayVar> = HashMap::new();
+    for var in &module.types_global_values {
+        if var.class.opcode != Op::Variable
+            || var.operands.first() != Some(&Operand::StorageClass(StorageClass::UniformConstant))
+        {
+            continue;
+        }
+        let (Some(id), Some(ptr_ty)) = (var.result_id, var.result_type) else {
+            continue;
+        };
+        let Some(array_ty) = defs.get(&ptr_ty).and_then(|p| id_at(p, 1)) else {
+            continue;
+        };
+        let Some(array) = defs.get(&array_ty) else {
+            continue;
+        };
+        if array.class.opcode != Op::TypeArray {
+            continue;
+        }
+        let (Some(elem_ty), Some(len_id)) = (id_at(array, 0), id_at(array, 1)) else {
+            continue;
+        };
+        let is_descriptor = defs.get(&elem_ty).is_some_and(|e| {
+            matches!(
+                e.class.opcode,
+                Op::TypeImage | Op::TypeSampler | Op::TypeSampledImage
+            )
+        });
+        let (Some(&len), Some(&binding)) = (constants.get(&len_id), bindings.get(&id)) else {
+            continue;
+        };
+        if !is_descriptor || len == 0 || len > 128 {
+            continue;
+        }
+        let elem_ptr_ty = module
+            .types_global_values
+            .iter()
+            .find(|t| {
+                t.class.opcode == Op::TypePointer
+                    && t.operands.first() == Some(&Operand::StorageClass(StorageClass::UniformConstant))
+                    && id_at(t, 1) == Some(elem_ty)
+            })
+            .and_then(|t| t.result_id);
+        let Some(elem_ptr_ty) = elem_ptr_ty else {
+            continue;
+        };
+        arrays.insert(
+            id,
+            ArrayVar {
+                elem_ptr_ty,
+                elem_ty,
+                len: len as u32,
+                binding,
+                elems: Vec::new(),
+            },
+        );
+    }
+    if arrays.is_empty() {
+        return false;
+    }
+
+    // Any reference outside the functions other than decorations, names and the entry point
+    // interface (an initializer, a specialization) keeps the module as it is.
+    for global in module
+        .types_global_values
+        .iter()
+        .chain(&module.execution_modes)
+    {
+        if global.operands.iter().any(|o| matches!(o, Operand::IdRef(id) if arrays.contains_key(id))) {
+            return false;
+        }
+    }
+
+    // Every use inside the functions.
+    let mut uses: HashMap<Word, Vec<(usize, usize, usize)>> = HashMap::new();
+    for (f, function) in module.functions.iter().enumerate() {
+        for (b, block) in function.blocks.iter().enumerate() {
+            for (i, inst) in block.instructions.iter().enumerate() {
+                for operand in &inst.operands {
+                    if let Operand::IdRef(id) = operand {
+                        uses.entry(*id).or_default().push((f, b, i));
+                    }
+                }
+            }
+        }
+        for parameter in &function.parameters {
+            if parameter.operands.iter().any(|o| matches!(o, Operand::IdRef(id) if arrays.contains_key(id))) {
+                return false;
+            }
+        }
+    }
+    let inst = |site: (usize, usize, usize)| -> &Instruction {
+        &module.functions[site.0].blocks[site.1].instructions[site.2]
+    };
+
+    // Plan: constant chains become a direct reference to element k, dynamic chains a set of replays.
+    let mut replace: HashMap<Word, (Word, u32)> = HashMap::new(); // chain result -> (array, k)
+    let mut dynamic_chains: HashMap<Word, (Word, Word)> = HashMap::new(); // chain result -> (array, index)
+    for (&array, info) in &arrays {
+        for &site in uses.get(&array).map(Vec::as_slice).unwrap_or(&[]) {
+            let chain = inst(site);
+            let shaped = matches!(chain.class.opcode, Op::AccessChain | Op::InBoundsAccessChain)
+                && chain.operands.len() == 2
+                && id_at(chain, 0) == Some(array);
+            let (Some(result), Some(index)) = (chain.result_id, id_at(chain, 1)) else {
+                return false;
+            };
+            if !shaped {
+                return false;
+            }
+            match constants.get(&index) {
+                // Metal leaves an out-of-range constant undefined; the last element is as good as any.
+                Some(&k) => {
+                    replace.insert(result, (array, (k as u32).min(info.len - 1)));
+                }
+                None => {
+                    dynamic_chains.insert(result, (array, index));
+                }
+            }
+        }
+    }
+
+    // A dynamic element's loads, the sampled images built from them and their consumers.
+    let mut dynamic_loads: HashMap<Word, Source> = HashMap::new();
+    let mut removable: HashSet<Word> = dynamic_chains.keys().copied().collect();
+    for (&chain, &(array, index)) in &dynamic_chains {
+        for &site in uses.get(&chain).map(Vec::as_slice).unwrap_or(&[]) {
+            let load = inst(site);
+            if load.class.opcode != Op::Load || id_at(load, 0) != Some(chain) {
+                return false;
+            }
+            let Some(result) = load.result_id else {
+                return false;
+            };
+            dynamic_loads.insert(result, Source::Dynamic { array, index });
+            removable.insert(result);
+        }
+    }
+    let source_of = |id: Word| -> Source { dynamic_loads.get(&id).copied().unwrap_or(Source::Fixed(id)) };
+    let mut replays: Vec<Replay> = Vec::new();
+    let mut replayed_sites: HashSet<(usize, usize, usize)> = HashSet::new();
+    // Sorted, so the ids this pass allocates (and the module bytes) do not depend on hash order.
+    let mut load_ids: Vec<Word> = dynamic_loads.keys().copied().collect();
+    load_ids.sort_unstable();
+    for &load in &load_ids {
+        for &site in uses.get(&load).map(Vec::as_slice).unwrap_or(&[]) {
+            let user = inst(site);
+            let op = user.class.opcode;
+            if is_direct_image_consumer(op) && id_at(user, 0) == Some(load) && user.result_id.is_some() {
+                if user.operands.iter().skip(1).any(|o| matches!(o, Operand::IdRef(id) if dynamic_loads.contains_key(id))) {
+                    return false;
+                }
+                if replayed_sites.insert(site) {
+                    replays.push(Replay {
+                        function: site.0,
+                        block: site.1,
+                        consumer: user.clone(),
+                        image: source_of(load),
+                        sampled: None,
+                    });
+                }
+                continue;
+            }
+            if op != Op::SampledImage {
+                return false;
+            }
+            let (Some(sampled), Some(sampled_ty), Some(image), Some(sampler)) =
+                (user.result_id, user.result_type, id_at(user, 0), id_at(user, 1))
+            else {
+                return false;
+            };
+            let (image, sampler) = (source_of(image), source_of(sampler));
+            let index_of = |s: Source| match s {
+                Source::Dynamic { index, .. } => Some(index),
+                Source::Fixed(_) => None,
+            };
+            if let (Some(a), Some(b)) = (index_of(image), index_of(sampler)) {
+                // tex[i] with smp[j]: replaying every pair is not worth it; tex[i] with smp[i] is.
+                if a != b {
+                    return false;
+                }
+            }
+            removable.insert(sampled);
+            for &consumer_site in uses.get(&sampled).map(Vec::as_slice).unwrap_or(&[]) {
+                let consumer = inst(consumer_site);
+                if !is_sampling_consumer(consumer.class.opcode)
+                    || id_at(consumer, 0) != Some(sampled)
+                    || consumer.result_id.is_none()
+                    || consumer.operands.iter().skip(1).any(|o| matches!(o, Operand::IdRef(id) if *id == sampled || dynamic_loads.contains_key(id)))
+                {
+                    return false;
+                }
+                if replayed_sites.insert(consumer_site) {
+                    replays.push(Replay {
+                        function: consumer_site.0,
+                        block: consumer_site.1,
+                        consumer: consumer.clone(),
+                        image,
+                        sampled: Some((sampled_ty, sampler)),
+                    });
+                }
+            }
+        }
+    }
+
+    replays.sort_by_key(|r| (r.function, r.block, r.consumer.result_id));
+
+    // Apply. Element variables first (binding base + k, every other decoration copied).
+    let array_ids: Vec<Word> = {
+        let mut ids: Vec<Word> = arrays.keys().copied().collect();
+        ids.sort_unstable();
+        ids
+    };
+    for &array in &array_ids {
+        let (len, ptr_ty, binding) = {
+            let a = &arrays[&array];
+            (a.len, a.elem_ptr_ty, a.binding)
+        };
+        let decorations: Vec<Instruction> = module
+            .annotations
+            .iter()
+            .filter(|i| matches!(i.class.opcode, Op::Decorate | Op::DecorateId) && id_at(i, 0) == Some(array))
+            .cloned()
+            .collect();
+        // After both the array and the element pointer type (which may be declared later).
+        let position = module
+            .types_global_values
+            .iter()
+            .rposition(|i| i.result_id == Some(array) || i.result_id == Some(ptr_ty))
+            .map_or(module.types_global_values.len(), |p| p + 1);
+        let mut variables = Vec::new();
+        for k in 0..len {
+            let id = module.fresh_id();
+            variables.push(Instruction::new(
+                Op::Variable,
+                Some(ptr_ty),
+                Some(id),
+                vec![Operand::StorageClass(StorageClass::UniformConstant)],
+            ));
+            for decoration in &decorations {
+                let mut copy = decoration.clone();
+                copy.operands[0] = Operand::IdRef(id);
+                if copy.operands.get(1) == Some(&Operand::Decoration(Decoration::Binding)) {
+                    copy.operands[2] = Operand::LiteralBit32(binding + k);
+                }
+                module.annotations.push(copy);
+            }
+            arrays.get_mut(&array).unwrap().elems.push(id);
+        }
+        module.types_global_values.splice(position..position, variables);
+    }
+
+    // Integer constants for the dynamic compares, and the bool type.
+    let mut new_globals = Vec::new();
+    let mut bool_ty = module
+        .types_global_values
+        .iter()
+        .find(|i| i.class.opcode == Op::TypeBool)
+        .and_then(|i| i.result_id);
+    let mut index_constants: HashMap<(Word, u32), Word> = HashMap::new();
+    if !replays.is_empty() {
+        if bool_ty.is_none() {
+            let id = module.fresh_id();
+            new_globals.push(Instruction::new(Op::TypeBool, None, Some(id), vec![]));
+            bool_ty = Some(id);
+        }
+        let value_types: HashMap<Word, Word> = module
+            .functions
+            .iter()
+            .flat_map(|f| f.parameters.iter().chain(f.all_inst_iter()))
+            .chain(&module.types_global_values)
+            .filter_map(|i| Some((i.result_id?, i.result_type?)))
+            .collect();
+        let mut wanted: Vec<(Word, u32)> = Vec::new();
+        for replay in &replays {
+            let index = match (replay.image, replay.sampled.map(|s| s.1)) {
+                (Source::Dynamic { index, array }, _) | (_, Some(Source::Dynamic { index, array })) => (index, array),
+                _ => continue,
+            };
+            let Some(&index_ty) = value_types.get(&index.0) else {
+                return false;
+            };
+            for k in 0..arrays[&index.1].len {
+                wanted.push((index_ty, k));
+            }
+        }
+        for (index_ty, k) in wanted {
+            if index_constants.contains_key(&(index_ty, k)) {
+                continue;
+            }
+            let width = defs.get(&index_ty).and_then(|t| literal_u32(t, 0));
+            let existing = module.types_global_values.iter().find(|i| {
+                i.class.opcode == Op::Constant
+                    && i.result_type == Some(index_ty)
+                    && match i.operands.first() {
+                        Some(Operand::LiteralBit32(v)) => *v as u64 == k as u64,
+                        Some(Operand::LiteralBit64(v)) => *v == k as u64,
+                        _ => false,
+                    }
+            });
+            let id = match existing.and_then(|i| i.result_id) {
+                Some(id) => id,
+                None => {
+                    let id = module.fresh_id();
+                    let literal = if width == Some(64) {
+                        Operand::LiteralBit64(k as u64)
+                    } else {
+                        Operand::LiteralBit32(k)
+                    };
+                    new_globals.push(Instruction::new(Op::Constant, Some(index_ty), Some(id), vec![literal]));
+                    id
+                }
+            };
+            index_constants.insert((index_ty, k), id);
+        }
+    }
+    module.types_global_values.append(&mut new_globals);
+    let bool_ty = bool_ty.unwrap_or(0);
+
+    // Dynamic replays: each consumer becomes one copy per element and a select chain on the index.
+    let value_types: HashMap<Word, Word> = module
+        .functions
+        .iter()
+        .flat_map(|f| f.parameters.iter().chain(f.all_inst_iter()))
+        .filter_map(|i| Some((i.result_id?, i.result_type?)))
+        .collect();
+    for replay in &replays {
+        let (array, index) = match (replay.image, replay.sampled.map(|s| s.1)) {
+            (Source::Dynamic { index, array }, _) | (_, Some(Source::Dynamic { index, array })) => (array, index),
+            _ => continue,
+        };
+        let len = arrays[&array].len;
+        let index_ty = value_types[&index];
+        let result_ty = replay.consumer.result_type.unwrap();
+        let result = replay.consumer.result_id.unwrap();
+        let mut out = Vec::new();
+        let mut per_element = Vec::new();
+        for k in 0..len {
+            let mut load = |source: Source, out: &mut Vec<Instruction>| -> Word {
+                match source {
+                    Source::Fixed(id) => id,
+                    Source::Dynamic { array, .. } => {
+                        let a = &arrays[&array];
+                        let id = module.fresh_id();
+                        out.push(Instruction::new(Op::Load, Some(a.elem_ty), Some(id), vec![Operand::IdRef(a.elems[k as usize])]));
+                        id
+                    }
+                }
+            };
+            let image = load(replay.image, &mut out);
+            let operand0 = match replay.sampled {
+                Some((sampled_ty, sampler)) => {
+                    let sampler = load(sampler, &mut out);
+                    let id = module.fresh_id();
+                    out.push(Instruction::new(Op::SampledImage, Some(sampled_ty), Some(id), vec![Operand::IdRef(image), Operand::IdRef(sampler)]));
+                    id
+                }
+                None => image,
+            };
+            let mut copy = replay.consumer.clone();
+            let id = module.fresh_id();
+            copy.result_id = Some(id);
+            copy.operands[0] = Operand::IdRef(operand0);
+            out.push(copy);
+            per_element.push(id);
+        }
+        let mut chosen = per_element[len as usize - 1];
+        for k in (0..len - 1).rev() {
+            let equal = module.fresh_id();
+            out.push(Instruction::new(
+                Op::IEqual,
+                Some(bool_ty),
+                Some(equal),
+                vec![Operand::IdRef(index), Operand::IdRef(index_constants[&(index_ty, k)])],
+            ));
+            let select = if k == 0 { result } else { module.fresh_id() };
+            out.push(Instruction::new(
+                Op::Select,
+                Some(result_ty),
+                Some(select),
+                vec![Operand::IdRef(equal), Operand::IdRef(per_element[k as usize]), Operand::IdRef(chosen)],
+            ));
+            chosen = select;
+        }
+        if len == 1 {
+            // A one-element array: the single copy is the result.
+            let last = out.last_mut().unwrap();
+            last.result_id = Some(result);
+        }
+        let block = &mut module.functions[replay.function].blocks[replay.block].instructions;
+        let Some(position) = block.iter().position(|i| i.result_id == Some(result)) else {
+            return false;
+        };
+        block.splice(position..=position, out);
+    }
+
+    // Constant chains: every use names the element variable; the chains go.
+    let rename: HashMap<Word, Word> = replace
+        .iter()
+        .map(|(&chain, &(array, k))| (chain, arrays[&array].elems[k as usize]))
+        .collect();
+    for function in &mut module.functions {
+        for block in &mut function.blocks {
+            block.instructions.retain(|i| i.result_id.is_none_or(|id| !rename.contains_key(&id)));
+            for inst in &mut block.instructions {
+                for operand in &mut inst.operands {
+                    if let Operand::IdRef(id) = operand {
+                        if let Some(&to) = rename.get(id) {
+                            *id = to;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // The dynamic chains, their loads and sampled images, once nothing uses them any more.
+    loop {
+        let used: HashSet<Word> = module
+            .all_inst_iter()
+            .flat_map(|i| i.operands.iter())
+            .filter_map(|o| match o {
+                Operand::IdRef(id) => Some(*id),
+                _ => None,
+            })
+            .collect();
+        let mut changed = false;
+        for function in &mut module.functions {
+            for block in &mut function.blocks {
+                let before = block.instructions.len();
+                block.instructions.retain(|i| {
+                    i.result_id.is_none_or(|id| !removable.contains(&id) || used.contains(&id))
+                });
+                changed |= block.instructions.len() != before;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    module.annotations.retain(|i| {
+        !matches!(i.class.opcode, Op::Decorate | Op::DecorateId)
+            || id_at(i, 0).is_none_or(|id| !removable.contains(&id) && !rename.contains_key(&id))
+    });
+
+    // The element variables join the entry point interface (SPIR-V 1.4+ lists every global it uses);
+    // drop_unreferenced_global_variables prunes the unused ones and the arrays themselves.
+    let lists_all_globals = module.header.as_ref().is_none_or(|h| h.version() >= (1, 4));
+    for entry_point in &mut module.entry_points {
+        let mut operands = Vec::new();
+        for (index, operand) in entry_point.operands.iter().enumerate() {
+            match operand {
+                Operand::IdRef(id) if index >= INTERFACE_START && arrays.contains_key(id) => {
+                    if lists_all_globals {
+                        operands.extend(arrays[id].elems.iter().map(|e| Operand::IdRef(*e)));
+                    }
+                }
+                other => operands.push(other.clone()),
+            }
+        }
+        entry_point.operands = operands;
+    }
+    crate::passes::drop_unreferenced_global_variables(module);
+    true
+}
