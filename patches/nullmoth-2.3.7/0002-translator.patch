+// The function-constant path closes a module's [[visible]] references against an empty linkage (the plugin's
+// nvmtl_translate_fc), so the emitter is what sees whether a reference survived the folding. Both ways RenderBox's custom
+// fragments use custom_fn -- a direct call, and the reference handed to a helper as a function pointer -- must end in the
+// one refusal the plugin defers to pipeline creation on; the pointer form used to fail as "unknown global value".
+fn closed_against_empty_linkage(ll: &str) -> String {
+    crate::linked_functions::specialize_visible_function_references(
+        ll,
+        &crate::linked_functions::LinkedFunctionLinkage::default(),
+    )
+    .expect("closing against an empty linkage")
+}
+
+fn assert_needs_linkage(err: &str) {
+    assert!(err.contains("visible function reference \"custom_fn\""), "{err}");
+    assert!(err.contains("no linked function supplies it"), "{err}");
+    assert!(!err.contains("unknown global value"), "{err}");
+}
+
+#[test]
+fn native_live_unsupplied_visible_call_asks_for_the_pipeline_linkage() {
+    let ll = closed_against_empty_linkage(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @main() {
+entry:
+  %r = tail call <4 x float> @custom_fn.MTL_VISIBLE_FN_REF(<2 x float> zeroinitializer)
+  ret <4 x float> %r
+}
+declare <4 x float> @custom_fn.MTL_VISIBLE_FN_REF(<2 x float>) section "air.externally_defined"
+!air.visible_function_references = !{!0}
+!0 = !{!"air.visible_function_reference", ptr @custom_fn.MTL_VISIBLE_FN_REF, !"custom_fn"}
+"#,
+    );
+    assert_needs_linkage(&emit_vulkan_spirv(&ll).expect_err("a live unsupplied call cannot be emitted"));
+}
+
+#[test]
+fn native_live_unsupplied_visible_reference_passed_as_pointer_asks_for_the_pipeline_linkage() {
+    let ll = closed_against_empty_linkage(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @main() {
+entry:
+  %r = tail call fastcc <4 x float> @sample_custom(ptr @custom_fn.MTL_VISIBLE_FN_REF, <2 x float> zeroinitializer)
+  ret <4 x float> %r
+}
+define internal fastcc <4 x float> @sample_custom(ptr %fn, <2 x float> %p) {
+entry:
+  %r = tail call <4 x float> %fn(<2 x float> %p)
+  ret <4 x float> %r
+}
+declare <4 x float> @custom_fn.MTL_VISIBLE_FN_REF(<2 x float>) section "air.externally_defined"
+!air.visible_function_references = !{!0}
+!0 = !{!"air.visible_function_reference", ptr @custom_fn.MTL_VISIBLE_FN_REF, !"custom_fn"}
+"#,
+    );
+    let err = emit_vulkan_spirv(&ll).expect_err("a live unsupplied reference cannot be emitted");
+    // the helper is emitted after main: the pointer operand of main's call is what is reached first
+    assert_needs_linkage(&err);
+}
+
+#[test]
+fn native_visible_reference_folded_away_by_constants_still_translates() {
+    // what the constants leave when they turn the only call off: the declaration and the reference list, no use
+    let ll = closed_against_empty_linkage(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @main() {
+entry:
+  ret <4 x float> zeroinitializer
+}
+declare <4 x float> @custom_fn.MTL_VISIBLE_FN_REF(<2 x float>) section "air.externally_defined"
+!air.visible_function_references = !{!0}
+!0 = !{!"air.visible_function_reference", ptr @custom_fn.MTL_VISIBLE_FN_REF, !"custom_fn"}
+"#,
+    );
+    assert!(!ll.contains(".MTL_VISIBLE_FN_REF"), "{ll}");
+    emit_vulkan_spirv(&ll).expect("a reference nothing uses after folding is not a reason to refuse");
+}
