+/// Local struct fields that hold a pointer into a descriptor array (the array itself, i.e. element 0,
+/// or `&array[k]`), keyed like the sidecar's pointer-field facts. The element is `None` for element 0.
+/// Those stores leave no sidecar fact when the stored pointer needs no placeholder, or when the
+/// store's address is the struct pointer itself rather than a GEP to its first field.
+fn stored_array_pointer_fields(
+    ctx: &Ctx,
+    entry_idx: usize,
+) -> HashMap<(Word, Vec<u32>), (Word, Option<Word>)> {
+    use crate::passes::access::local_pointer_field_access_key;
+    let mut access_keys = HashMap::new();
+    let mut stored = HashMap::new();
+    for block in &ctx.module.functions[entry_idx].blocks {
+        for inst in &block.instructions {
+            if let Some((result, key)) = local_pointer_field_access_key(ctx, &access_keys, inst) {
+                access_keys.insert(result, key);
+            }
+            if inst.class.opcode != Op::Store {
+                continue;
