+/// (base + k) because the plugin's layout has one descriptorCount-1 binding per Metal slot; indexing
+/// a descriptor array past element 0 is undefined (NVK clamps it under robustBufferAccess).
+fn split_descriptor_array_fragment(name: &str, ll: &str) -> (Module, String) {
+    let tmp = std::env::temp_dir().join(format!("metal2vulkan_{name}_{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Fragment, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    let _ = std::fs::remove_dir_all(tmp);
+    (load_bytes(&spv).expect("load"), asm)
+}
+
+fn descriptor_bindings(module: &Module) -> Vec<u32> {
+    let mut out: Vec<u32> = module
+        .annotations
+        .iter()
+        .filter(|i| i.operands.get(1) == Some(&Operand::Decoration(Decoration::Binding)))
+        .filter_map(|i| match i.operands.get(2) {
+            Some(Operand::LiteralBit32(b)) => Some(*b),
+            _ => None,
+        })
+        .collect();
+    out.sort_unstable();
+    out
+}
+
+fn uniform_constant_array_variables(module: &Module) -> usize {
+    module
+        .types_global_values
+        .iter()
+        .filter(|i| i.class.opcode == Op::Variable)
+        .filter_map(|i| variable_pointee_type(module, i.result_id?))
+        .filter(|ty| {
+            module
+                .types_global_values
+                .iter()
+                .any(|t| t.result_id == Some(*ty) && t.class.opcode == Op::TypeArray)
+        })
+        .count()
+}
+
+#[test]
+fn native_angle_sampler2d_array_elements_get_their_own_bindings() {
+    // ANGLE's `uniform sampler2D u_texture[16]` (xterm.js glyph pages): constant indices only.
+    let (module, asm) = split_descriptor_array_fragment(
+        "angle_sampler2d_array16",
+        include_str!("fixtures/descriptor_arrays/angle_sampler2d_array16.ll"),
+    );
+    assert_eq!(uniform_constant_array_variables(&module), 0, "{asm}");
+    let expected: Vec<u32> = (32..48).chain(160..176).collect();
+    assert_eq!(descriptor_bindings(&module), expected, "{asm}");
+    assert_eq!(asm.matches("OpImageSampleImplicitLod").count(), 16, "{asm}");
+}
+
+#[test]
+fn native_dynamic_texture_array_index_replays_each_element_and_selects() {
+    // `tex[page].sample(smp[page], uv)` with a varying index: one sample per element, chosen by index.
+    let (module, asm) = split_descriptor_array_fragment(
+        "dynamic_texture_array16",
+        include_str!("fixtures/descriptor_arrays/dynamic_texture_array16.ll"),
+    );
+    assert_eq!(uniform_constant_array_variables(&module), 0, "{asm}");
+    let expected: Vec<u32> = (32..48).chain(160..176).collect();
+    assert_eq!(descriptor_bindings(&module), expected, "{asm}");
+    assert_eq!(asm.matches("OpImageSampleImplicitLod").count(), 16, "{asm}");
+    assert_eq!(asm.matches("OpIEqual").count(), 15, "{asm}");
+}
