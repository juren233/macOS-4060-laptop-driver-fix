+/// What the static initializer leaves in one aggregate global (see `meta::StaticInitAggregates`): the value of each
+/// leaf it stored, a leaf being a scalar or vector reached through constant struct/array indices.
+#[derive(Clone, Debug, Default)]
+pub(super) struct StaticAggregateImage {
+    zero_initialized: bool,
+    leaves: HashMap<Vec<u64>, (LlType, meta::StaticIntValue)>,
+}
+
+fn static_aggregate_constant(ty: &LlType, value: &meta::StaticIntValue) -> Option<TypedValue> {
+    match (ty, value) {
+        (LlType::Int(_), meta::StaticIntValue::Scalar(value)) => Some(TypedValue {
+            ty: ty.clone(),
+            value: LlValue::Int(u64::from(*value)),
+        }),
+        (LlType::Vector(element, lanes), meta::StaticIntValue::Vector(values))
+            if matches!(**element, LlType::Int(_)) && values.len() == *lanes as usize =>
+        {
+            Some(TypedValue {
+                ty: ty.clone(),
+                value: LlValue::Vector(
+                    values
+                        .iter()
+                        .map(|value| TypedValue {
+                            ty: (**element).clone(),
+                            value: LlValue::Int(u64::from(*value)),
+                        })
+                        .collect(),
+                ),
+            })
+        }
+        _ => None,
+    }
+}
+
+impl LlModule {
+    /// The leaf an access of `access_ty` at constant `indices` into `source_ty` addresses: the indices walked, then
+    /// first members until the type is `access_ty`. None unless that ends exactly on an integer scalar or integer
+    /// vector leaf (part of a vector, a whole aggregate, a type pun).
+    fn static_aggregate_leaf(
+        &self,
+        source_ty: &LlType,
+        indices: &[u64],
+        access_ty: &LlType,
+    ) -> Option<Vec<u64>> {
+        let (&first, rest) = indices.split_first()?;
+        if first != 0 {
+            return None;
+        }
+        let mut path = vec![0];
+        let mut current = self.resolve_known_type(source_ty);
+        for &index in rest {
+            current = match current {
+                LlType::Struct(fields) => fields.get(usize::try_from(index).ok()?)?.clone(),
+                LlType::Array(element, len) if index < u64::from(len) => *element,
+                _ => return None,
+            };
+            current = self.resolve_known_type(&current);
+            path.push(index);
+        }
+        let access = self.resolve_known_type(access_ty);
+        loop {
+            if current == access {
+                let leaf = match &current {
+                    LlType::Int(_) => true,
+                    LlType::Vector(element, _) => matches!(**element, LlType::Int(_)),
+                    _ => false,
+                };
+                return leaf.then_some(path);
+            }
+            current = match current {
+                LlType::Struct(fields) => self.resolve_known_type(fields.first()?),
+                LlType::Array(element, len) if len > 0 => self.resolve_known_type(&element),
+                _ => return None,
+            };
+            path.push(0);
+        }
+    }
+
+    /// The constant address `ptr` names inside an aggregate in `static_init_aggregates`: the global, the type the
+    /// indices walk, and the indices.
+    fn static_aggregate_address(
+        &self,
+        ptr: &TypedValue,
+        geps: &HashMap<String, (String, LlType, Vec<u64>)>,
+        aggregates: &HashMap<String, StaticAggregateImage>,
+    ) -> Option<(String, LlType, Vec<u64>)> {
+        match &ptr.value {
+            LlValue::Global(global) => {
+                if !aggregates.contains_key(global) {
+                    return None;
+                }
+                let ty = self.globals.iter().find(|g| &g.name == global)?.ty.clone();
+                Some((global.clone(), ty, vec![0]))
+            }
+            LlValue::Local(name) => geps.get(name).cloned(),
+            LlValue::Gep(gep) => {
+                let LlValue::Global(global) = &gep.base.value else {
+                    return None;
+                };
+                let indices = gep
+                    .indices
+                    .iter()
+                    .map(constant_int)
+                    .collect::<Option<Vec<_>>>()?;
+                aggregates
+                    .contains_key(global)
+                    .then(|| (global.clone(), gep.source_ty.clone(), indices))
+            }
+            _ => None,
+        }
+    }
+
+    /// The leaves the static initializer stores into each foldable aggregate global, replayed in order. A global with
+    /// a store this cannot place on one leaf, or whose value is unknown, is left out entirely.
+    pub(super) fn static_init_aggregate_images(
+        &self,
+        ll: &str,
+    ) -> HashMap<String, StaticAggregateImage> {
+        let Some(aggregates) = meta::static_init_foldable_aggregates(ll) else {
+            return HashMap::new();
+        };
+        let Some(initializer) = self.functions.iter().find(|function| {
+            function.is_static_initializer
+                && function.name.trim_start_matches('@')
+                    == aggregates.initializer.trim_start_matches('@')
+        }) else {
+            return HashMap::new();
+        };
+        let mut images = aggregates
+            .globals
+            .iter()
+            .filter_map(|name| {
+                let global = self.globals.iter().find(|global| &global.name == name)?;
+                let zero_initialized = match global.initializer.as_ref().map(|init| &init.value) {
+                    Some(LlValue::Zero) => true,
+                    Some(LlValue::Undef) => false,
+                    _ => return None,
+                };
+                Some((
+                    name.clone(),
+                    StaticAggregateImage {
+                        zero_initialized,
+                        leaves: HashMap::new(),
+                    },
+                ))
+            })
+            .collect::<HashMap<_, _>>();
+        let mut failed = HashSet::new();
+        // the entry block only: meta::static_init_foldable_aggregates proved no other block references these globals
+        let entry_insts = initializer
+            .blocks
+            .first()
+            .and_then(|block| block.typed.as_ref())
+            .map(|typed| typed.insts.as_slice())
+            .unwrap_or_default();
+        for inst in entry_insts {
+            let Some((value, ptr)) = inst.store().as_deref() else {
+                continue;
+            };
+            let Some((global, source_ty, indices)) =
+                self.static_aggregate_address(ptr, &HashMap::new(), &images)
+            else {
+                continue;
+            };
+            let stored = match &value.value {
+                LlValue::Local(name) => aggregates.values.get(name).cloned(),
+                LlValue::Int(value) => u32::try_from(*value).ok().map(meta::StaticIntValue::Scalar),
+                LlValue::Bool(value) => Some(meta::StaticIntValue::Scalar(u32::from(*value))),
+                LlValue::Zero => match self.resolve_known_type(&value.ty) {
+                    LlType::Vector(_, lanes) => Some(meta::StaticIntValue::Vector(vec![0; lanes as usize])),
+                    LlType::Int(_) => Some(meta::StaticIntValue::Scalar(0)),
+                    _ => None,
+                },
+                _ => None,
+            };
+            let leaf = self.static_aggregate_leaf(&source_ty, &indices, &value.ty);
+            match (stored, leaf, images.get_mut(&global)) {
+                (Some(stored), Some(leaf), Some(image)) => {
+                    let ty = self.resolve_known_type(&value.ty);
+                    if static_aggregate_constant(&ty, &stored).is_none() {
+                        failed.insert(global);
+                        continue;
+                    }
+                    image.leaves.insert(leaf, (ty, stored));
+                }
+                _ => {
+                    failed.insert(global);
+                }
+            }
+        }
+        images.retain(|global, _| !failed.contains(global));
+        images
+    }
+}
