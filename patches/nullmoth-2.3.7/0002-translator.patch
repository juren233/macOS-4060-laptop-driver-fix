+                ctx.array_element_ptrs
+                    .get(value)
+                    .map(|&(arrayvar, element)| (arrayvar, Some(element)))
+            };
+            if let Some(target) = target {
+                stored.insert((key.root, trim_zero_indices(&key.indices)), target);
+            }
+        }
+    }
+    stored
