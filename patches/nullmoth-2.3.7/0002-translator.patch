+pub(crate) fn static_init_foldable_aggregates(ll: &str) -> Option<StaticInitAggregates> {
+    // candidate globals: `@g = internal ... global <aggregate type> zeroinitializer|undef`
+    let mut candidates = HashSet::new();
+    for raw in ll.lines() {
+        let line = raw.split(';').next().unwrap_or(raw).trim();
+        if !line.starts_with('@') {
+            continue;
+        }
+        let Some((name, rest)) = line.split_once(" = ") else {
+            continue;
+        };
+        if !rest.starts_with("internal ") || rest.contains(" constant ") {
+            continue;
+        }
+        let Some((_, typed_init)) = rest.split_once(" global ") else {
+            continue;
+        };
+        if !(typed_init.starts_with('%') || typed_init.starts_with('{') || typed_init.starts_with("<{") || typed_init.starts_with('[')) {
+            continue;
+        }
+        let init = typed_init.split(", align").next().unwrap_or(typed_init).trim_end();
+        if init.ends_with(" zeroinitializer") || init.ends_with(" undef") {
+            candidates.insert(name.trim().to_string());
+        }
+    }
+    if candidates.is_empty() {
+        return None;
+    }
+
+    // exactly one static initializer; only stores in its entry block count: that block runs once, unconditionally,
+    // before anything else reads them, and the evaluator's values for it follow program order
+    let mut initializer = None;
+    let mut in_static_init = false;
+    let mut in_function = false;
+    let mut in_entry_block = false;
+    for raw in ll.lines() {
+        let line = raw.split(';').next().unwrap_or(raw).trim();
+        if line.starts_with("define ") {
+            in_function = true;
+            in_static_init = crate::air_static_init::define_line_declares_static_initializer(line);
+            if in_static_init {
+                if initializer.is_some() {
+                    return None;
+                }
+                let name = line.split_once('@')?.1.split('(').next()?;
+                initializer = Some(format!("@{name}"));
+                in_entry_block = true;
+            }
+            continue;
+        }
+        if line == "}" {
+            in_function = false;
+            in_static_init = false;
+            continue;
+        }
+        if !in_function {
+            continue;
+        }
+        if in_static_init {
+            if line.ends_with(':') {
+                in_entry_block = false;
+            }
+            // the initializer may only store into a candidate through a constant address, in its entry block, never
+            // read it or pass it on
+            let referenced = candidates.iter().filter(|g| references_symbol(line, g)).cloned().collect::<Vec<_>>();
+            for global in referenced {
+                let ok = in_entry_block && line.strip_prefix("store ").is_some_and(|rest| {
+                    rest.split_once(',').is_some_and(|(value, ptr)| {
+                        !references_symbol(value, &global) && store_target_global(ptr).as_deref() == Some(global.as_str())
+                    })
+                });
+                if !ok {
+                    candidates.remove(&global);
+                }
+            }
+            if ["br ", "switch ", "ret ", "unreachable", "indirectbr ", "resume "].iter().any(|t| line.starts_with(t)) {
+                in_entry_block = false;
+            }
+            continue;
+        }
+    }
+    let initializer = initializer?;
+
+    // everywhere else, a candidate (and every pointer derived from it by select/getelementptr) may only be loaded from
+    for global in candidates.clone() {
+        let mut derived = HashSet::<String>::new();
+        let mut in_other = false;
+        let mut escaped = false;
+        for raw in ll.lines() {
+            let line = raw.split(';').next().unwrap_or(raw).trim();
+            if line.starts_with("define ") {
+                in_other = !crate::air_static_init::define_line_declares_static_initializer(line);
+                derived.clear();
+                continue;
+            }
+            if line == "}" {
+                in_other = false;
+                continue;
+            }
+            if line.starts_with('@') && references_symbol(line, &global) && !line.starts_with(&format!("{global} ")) {
+                escaped = true; // another global's initializer takes its address
+                break;
+            }
+            if !in_other || line.is_empty() {
+                continue;
+            }
+            let uses = references_symbol(line, &global) || references_any_local(line, &derived);
+            if !uses {
+                continue;
+            }
+            let Some((result, rhs)) = line.split_once(" = ") else {
+                escaped = true;
+                break;
+            };
+            let result = result.trim();
+            if let Some(load) = rhs.strip_prefix("load ") {
+                // `load <ty>, ptr ... <pointer>`: the derived pointer is only the address
+                let pointer = load.split_once(',').map_or("", |(_, ptr)| ptr);
+                let value_type = load.split_once(',').map_or(load, |(ty, _)| ty);
+                if references_symbol(value_type, &global) || references_any_local(value_type, &derived) || pointer.is_empty() {
+                    escaped = true;
+                    break;
+                }
+                continue;
+            }
+            if rhs.starts_with("select ") || rhs.starts_with("getelementptr ") {
+                if rhs.starts_with("select ") {
+                    // the condition must not be a derived pointer
+                    let cond = rhs["select ".len()..].split(',').next().unwrap_or("");
+                    if references_symbol(cond, &global) || references_any_local(cond, &derived) {
+                        escaped = true;
+                        break;
+                    }
+                } else {
+                    // only as the base: the indices must not be derived pointers
+                    let mut operands = rhs.splitn(3, ',');
+                    let _ty = operands.next();
+                    let _base = operands.next();
+                    let indices = operands.next().unwrap_or("");
+                    if references_symbol(indices, &global) || references_any_local(indices, &derived) {
+                        escaped = true;
+                        break;
+                    }
+                }
+                derived.insert(result.to_string());
+                continue;
+            }
+            escaped = true;
+            break;
+        }
+        if escaped {
+            candidates.remove(&global);
+        }
+    }
+    if candidates.is_empty() {
+        return None;
+    }
+
+    let (_, env) = static_init_evaluation(ll);
+    let values = env
+        .into_iter()
+        .filter_map(|(name, value)| {
+            let value = match value {
+                StaticValue::Bool(value) => StaticIntValue::Scalar(u32::from(value)),
+                StaticValue::Int(value) => StaticIntValue::Scalar(u32::try_from(value).ok()?),
+                StaticValue::Vector(values) => StaticIntValue::Vector(
+                    values.into_iter().map(u32::try_from).collect::<Result<_, _>>().ok()?,
+                ),
+            };
+            Some((name, value))
+        })
+        .collect();
+    Some(StaticInitAggregates {
+        initializer,
+        globals: candidates,
+        values,
+    })
 }
 
 pub(crate) fn static_init_foldable_global_values(ll: &str) -> HashMap<String, StaticIntValue> {
@@ -229,6 +476,31 @@ pub(crate) fn static_init_foldable_global_values(ll: &str) -> HashMap<String, St
         .collect()
