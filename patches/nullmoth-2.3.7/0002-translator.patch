+/// The global a store's pointer operand addresses directly, or through a constant `getelementptr` expression whose
+/// indices are all integer literals.
+fn store_target_global(ptr_text: &str) -> Option<String> {
+    fn strip_ptr_type(text: &str) -> Option<&str> {
+        let rest = text.trim_start().strip_prefix("ptr")?.trim_start();
+        Some(match rest.strip_prefix("addrspace(") {
+            Some(after) => after.split_once(')')?.1.trim_start(),
+            None => rest,
+        })
+    }
+    let rest = strip_ptr_type(ptr_text)?;
+    if rest.starts_with('@') {
+        return parse_global_name(rest);
+    }
+    let inner = rest.strip_prefix("getelementptr")?.trim_start();
+    let inner = inner.strip_prefix("inbounds").unwrap_or(inner).trim_start();
+    let inner = inner.strip_prefix('(')?;
+    let mut depth = 0usize;
+    let close = inner.char_indices().find_map(|(at, c)| match c {
+        '(' => {
+            depth += 1;
+            None
+        }
+        ')' if depth == 0 => Some(at),
+        ')' => {
+            depth -= 1;
+            None
+        }
+        _ => None,
+    })?;
+    let mut parts = inner[..close].splitn(3, ',');
+    let _source_type = parts.next()?;
+    let base = strip_ptr_type(parts.next()?)?;
+    if !base.starts_with('@') {
+        return None;
+    }
+    let indices = parts.next().unwrap_or("");
+    let literal_indices = indices.trim().is_empty()
+        || indices.split(',').all(|index| {
+            let mut tokens = index.split_whitespace();
+            tokens.next().is_some_and(|ty| ty.starts_with('i'))
+                && tokens.next().is_some_and(|value| value.parse::<i64>().is_ok())
+                && tokens.next().is_none()
+        });
+    literal_indices.then(|| parse_global_name(base)).flatten()
+}
