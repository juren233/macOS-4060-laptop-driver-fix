+/// Whether `text` names any of `locals` (`%name` symbols, matched with `references_symbol`'s boundaries).
+fn references_any_local(text: &str, locals: &HashSet<String>) -> bool {
+    if locals.is_empty() {
+        return false;
+    }
+    // a quoted or otherwise unusual name is not a single token here: search for it as written
+    if locals.iter().any(|local| !local.as_bytes()[1..].iter().all(|&b| symbol_byte(b))) {
+        return locals.iter().any(|local| references_symbol(text, local));
+    }
+    let bytes = text.as_bytes();
+    let mut at = 0;
+    while let Some(found) = text[at..].find('%') {
+        let start = at + found;
+        let end = bytes[start + 1..]
+            .iter()
+            .position(|&b| !symbol_byte(b))
+            .map_or(bytes.len(), |len| start + 1 + len);
+        if (start == 0 || !symbol_byte(bytes[start - 1])) && locals.contains(&text[start..end]) {
+            return true;
+        }
+        at = start + 1;
+    }
+    false
+}
+
 fn symbol_byte(byte: u8) -> bool {
     matches!(byte, b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'_' | b'.' | b'$')
 }
