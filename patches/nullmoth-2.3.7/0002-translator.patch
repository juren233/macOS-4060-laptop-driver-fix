+pub fn with_argument_buffer_samplers<R>(f: impl FnOnce() -> R) -> R {
+    ARGBUF_SAMPLERS.with(|c| c.set(true));
+    RAW_BUFFERS_FIRST.with(|c| c.set(true));
+    let r = f();
+    ARGBUF_SAMPLERS.with(|c| c.set(false));
+    RAW_BUFFERS_FIRST.with(|c| c.set(false));
