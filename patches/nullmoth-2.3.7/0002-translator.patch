+/// Exactly where `rewrite_block_label_line` returns Some, without building its result.
+fn is_block_label_line(line: &str) -> bool {
+    let rest = line.trim_start();
+    let Some(colon) = rest.find(':') else {
+        return false;
+    };
+    let ident = &rest[..colon];
+    if ident.is_empty() {
+        return false;
+    }
+    let bare = ident.strip_prefix('%').unwrap_or(ident);
+    if !bare.chars().all(is_name_char) {
+        return false;
+    }
+    let after = rest[colon + 1..].trim_start();
+    after.is_empty() || after.starts_with(';')
+}
