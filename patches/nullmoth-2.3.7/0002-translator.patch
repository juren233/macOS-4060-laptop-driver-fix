+                (inst.operands.first(), inst.operands.get(1))
+            else {
+                continue;
+            };
+            let Some(key) = access_keys.get(ptr) else {
+                continue;
+            };
+            let target = if ctx.image_array_vars.contains_key(value) {
+                Some((*value, None))
