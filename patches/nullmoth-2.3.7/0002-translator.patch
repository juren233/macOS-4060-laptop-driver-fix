+/// Whether `rename_line` would see `value` (a `%name`) as a whole token in `line`: it reads the maximal run of name
+/// characters after each `%`, so an occurrence followed by another name character (`%12` in `%123`) is not one.
+fn names_value(line: &str, value: &str) -> bool {
+    let (line, value) = (line.as_bytes(), value.as_bytes());
+    let Some(&first) = value.first() else {
+        return false;
+    };
+    let mut at = 0;
+    while let Some(found) = line[at..].iter().position(|&b| b == first) {
+        let start = at + found;
+        if line[start..].starts_with(value)
+            && line
+                .get(start + value.len())
+                .is_none_or(|&b| !is_name_char(b as char))
+        {
+            return true;
+        }
+        at = start + 1;
+    }
+    false
+}
