diff --git a/AirportItlwm/AirportItlwmV2.cpp b/AirportItlwm/AirportItlwmV2.cpp
index ea1c5ac..be650c0 100644
--- a/AirportItlwm/AirportItlwmV2.cpp
+++ b/AirportItlwm/AirportItlwmV2.cpp
@@ -113,11 +113,55 @@ eventHandler(struct ieee80211com *ic, int msgCode, void *data)
 #endif
 }
 
+// arg0: 0 = interface is down (init failed and cleared IFF_UP),
+//       1 = IFF_UP left set without IFF_RUNNING (init never ran / was skipped).
+IOReturn AirportItlwm::initRecoverGated(OSObject *owner, void *arg0, void *, void *, void *)
+{
+    AirportItlwm *that = OSDynamicCast(AirportItlwm, owner);
+    if (!that || !that->power_state)
+        return kIOReturnSuccess;
+    struct _ifnet *ifp = &that->fHalService->get80211Controller()->ic_ac.ac_if;
+    if (ifp->if_flags & IFF_RUNNING)
+        return kIOReturnSuccess;
+    bool staleUp = arg0 != NULL;
+    if (staleUp != ((ifp->if_flags & IFF_UP) != 0))
+        return kIOReturnSuccess;
+    that->initRecoverCount++;
+    IOLog("itlwm: init recovery #%u (%s), restarting firmware\n", that->initRecoverCount,
+          staleUp ? "stale IFF_UP" : "interface stopped while powered");
+    that->setProperty("ItlwmInitRecoveries", that->initRecoverCount, 32);
+    if (staleUp)
+        that->fHalService->disable(that->bsdInterface);
+    that->fHalService->enable(that->bsdInterface);
+    return kIOReturnSuccess;
+}
+
 void AirportItlwm::watchdogAction(IOTimerEventSource *timer)
 {
     struct _ifnet *ifp = &fHalService->get80211Controller()->ic_ac.ac_if;
     (*ifp->if_watchdog)(ifp);
 
+    // airportd only sends power-on once; if firmware init fails afterwards the
+    // driver stays off while reporting power on. Retry with backoff, which is
+    // what a manual Wi-Fi off/on does.
+    int flags = ifp->if_flags;
+    if (!power_state || (flags & IFF_RUNNING)) {
+        initRecoverTicks = 0;
+        initRecoverDelay = 3;
+        initStaleUpTicks = 0;
+    } else if (!(flags & IFF_UP)) {
+        initStaleUpTicks = 0;
+        if (++initRecoverTicks >= initRecoverDelay) {
+            initRecoverTicks = 0;
+            initRecoverDelay = MIN(initRecoverDelay * 2, 60U);
+            _fCommandGate->runAction(initRecoverGated, NULL);
+        }
+    } else if (++initStaleUpTicks >= 30) {
+        // A normal firmware load reaches IFF_RUNNING in well under 10 s.
+        initStaleUpTicks = 0;
+        _fCommandGate->runAction(initRecoverGated, (void *)1);
+    }
+
     watchdogTimer->setTimeoutMS(kWatchDogTimerPeriod);
 }
 
@@ -141,6 +185,10 @@ bool AirportItlwm::init(OSDictionary *properties)
     bool ret = super::init(properties);
     awdlSyncEnable = true;
     power_state = 0;
+    initRecoverTicks = 0;
+    initRecoverDelay = 3;
+    initRecoverCount = 0;
+    initStaleUpTicks = 0;
     memset(geo_location_cc, 0, sizeof(geo_location_cc));
     return ret;
 }
