diff --git a/itlwm/hal_iwx/ItlIwx.cpp b/itlwm/hal_iwx/ItlIwx.cpp
index 740cba0..3ccdfac 100644
--- a/itlwm/hal_iwx/ItlIwx.cpp
+++ b/itlwm/hal_iwx/ItlIwx.cpp
@@ -4895,7 +4895,14 @@ iwx_load_firmware(struct iwx_softc *sc)
         return err;
     }
     
-    err = iwx_wait_notification(sc, &sc->sc_uc.uc_intr, 1, 1000);
+    // At boot IO80211Family parks external ioctls for up to ~5 s each while the driver is not yet
+    // available, inside the work loop gate this driver shares with it. The ALIVE interrupt needs that
+    // gate, so the first load is held off 5-11 s (2026-10-12 boot logs). The old 1 s budget made
+    // some boots fail both attempts; success still returns as soon as ALIVE is processed.
+    uint64_t aliveStart = mach_absolute_time(), aliveNs;
+    err = iwx_wait_notification(sc, &sc->sc_uc.uc_intr, 1, 15000);
+    absolutetime_to_nanoseconds(mach_absolute_time() - aliveStart, &aliveNs);
+    IOLog("itlwm: firmware alive wait %llu ms, err %d ok %d\n", aliveNs / 1000000ULL, err, sc->sc_uc.uc_ok);
     if (err == ENXIO)
         return err;
     if (!err && !sc->sc_uc.uc_ok)
@@ -10770,7 +10777,7 @@ iwx_init(struct _ifnet *ifp)
             break;
         generation = ++sc->sc_generation;
         iwx_stop_device(sc);
-        if (attempt != 0 || err == ENXIO || !(ifp->if_flags & IFF_UP) ||
+        if (attempt >= 2 || err == ENXIO || !(ifp->if_flags & IFF_UP) ||
             (sc->sc_flags & (IWX_FLAG_RFKILL | IWX_FLAG_HW_ERR)))
             return err;
         XYLog("%s: retrying firmware initialization after error %d\n", DEVNAME(sc), err);
