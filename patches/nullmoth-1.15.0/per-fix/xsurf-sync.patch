+// Committed GPU work outlives its process on Apple GPUs; here the execution worker submits and publishes it, and a process that
+// exits right after a commit (gfx4's producer after its last frame) left the surface unpublished - the consumer timed out and
+// read the old frame. At exit, give the worker up to 1 s to finish what was committed.
+static void nvmtl_exit_drain(void) {
+    const uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    for (;;) {
+        NSUInteger n;
+        @synchronized ([NVMTLCommandBuffer class]) { n = nvmtl_pending_buffers.count; }
+        if (!n) break;
+        if (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0 > 1000000000ull) {
+            nvdiag_emit("exit: %lu committed command buffers still unfinished after 1 s - exiting anyway", (unsigned long)n); break; }
+        usleep(500);
+    }
+}
