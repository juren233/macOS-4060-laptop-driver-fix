+/// Length of the array a sampler entry parameter points to (`array<sampler, N>` arrives as a
+/// pointer to `[N x ptr]`); `None` for a plain sampler.
+fn sampler_param_array_length(defs: &HashMap<Word, Instruction>, param_ty: Word) -> Option<u32> {
+    let array = defs.get(&ptr_pointee(defs, param_ty)?)?;
+    if array.class.opcode != Op::TypeArray {
+        return None;
+    }
+    let Some(Operand::IdRef(length)) = array.operands.get(1) else {
+        return None;
+    };
+    let length = defs.get(length)?;
+    if length.class.opcode != Op::Constant {
+        return None;
+    }
+    match length.operands.first()? {
+        Operand::LiteralBit32(n) => Some(*n),
+        Operand::LiteralBit64(n) => u32::try_from(*n).ok(),
+        _ => None,
+    }
+}
