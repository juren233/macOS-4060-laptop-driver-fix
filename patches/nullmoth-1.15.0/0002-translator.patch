+/// Remember which element of a descriptor array each `&param[k]` chain addresses, before the
+/// chains are retired as dead: the element pointers only reach their consumers through memory
+/// (ANGLE keeps `thread T *texture` in a local struct), where the sidecar facts name them by id.
+fn record_array_element_pointers(ctx: &mut Ctx, entry_idx: usize, param: Word, var: Word) {
+    let mut found = Vec::new();
+    for block in &ctx.module.functions[entry_idx].blocks {
+        for instruction in &block.instructions {
+            if !matches!(
+                instruction.class.opcode,
+                Op::AccessChain | Op::InBoundsAccessChain
+            ) {
+                continue;
+            }
+            if let (Some(result), [Operand::IdRef(base), Operand::IdRef(index)]) =
+                (instruction.result_id, instruction.operands.as_slice())
+            {
+                if *base == param {
+                    found.push((result, (var, *index)));
+                }
+            }
+        }
+    }
+    ctx.array_element_ptrs.extend(found);
+}
