+/// Trailing zero indices address the same bytes as their prefix, and the emitter folds such
+/// all-zero GEPs away, so the store of element 0 and the load of its first field differ only there.
+fn trim_zero_indices(indices: &[u32]) -> Vec<u32> {
+    let end = indices.iter().rposition(|&index| index != 0).map_or(0, |at| at + 1);
+    indices[..end].to_vec()
+}
