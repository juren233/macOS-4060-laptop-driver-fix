+/* ===== LOCAL-FIX (this Hackintosh, RTX 4060 / macOS 15): persistent VkPipelineCache
+ * DO NOT REMOVE, REVERT OR 'SIMPLIFY' when merging upstream NullMoth changes - without it every boot recompiles all NVK shaders and WindowServer sits at ~100% CPU for minutes after login.
+ * History: git log in ~/work/nvidia-setup/src/repo (branch local-mods). Installed + guarded by ~/work/system/nvguard. ===== */
+/* Persistent VkPipelineCache: every NVK shader compile (NIR -> NAK) used to be redone from scratch on every boot, because pipelines were
+ * created with VK_NULL_HANDLE.  WindowServer alone spent most of its first minutes after login in nvk_compile_shaders.  The cache lives next
+ * to the SPIR-V cache, is keyed by the Vulkan driver build (size+mtime), and is merged with what other processes of the same user stored. */
+static VkPipelineCache g_pcache;
+static char g_pcache_path[1024];
+static _Atomic unsigned g_pcache_gen, g_pcache_saved;
+static _Atomic int g_pcache_timer;
+static size_t g_pcache_lastsz;
+#define NVMTL_PCACHE_MAX (512ull << 20)
+
+static void *nvmtl_pcache_read(const char *path, size_t *n)
+{
+    int fd = open(path, O_RDONLY | O_CLOEXEC); if (fd < 0) return NULL;
+    struct stat st; void *buf = NULL;
+    if (fstat(fd, &st) == 0 && st.st_size > 32 && (unsigned long long)st.st_size <= NVMTL_PCACHE_MAX && (buf = malloc((size_t)st.st_size))) {
+        size_t got = 0;
+        while (got < (size_t)st.st_size) { ssize_t r = read(fd, (char *)buf + got, (size_t)st.st_size - got); if (r <= 0) break; got += (size_t)r; }
+        if (got != (size_t)st.st_size) { free(buf); buf = NULL; } else *n = got;
+    }
+    close(fd);
+    return buf;
+}
+
+static void nvmtl_pcache_save_now(void)
+{
