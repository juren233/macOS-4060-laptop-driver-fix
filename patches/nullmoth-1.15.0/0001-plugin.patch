index 0000000..20173ae
--- /dev/null
+++ b/plugin/nvmtl_bindfix.h
@@ -0,0 +1,275 @@
+// nvmtl_bindfix.h - keeps the kernel's "which connection owns this fd number" table free of duplicates.
+//
+// libvulkan_nouveau (nvrm_xnu.c) gives every RM connection a placeholder fd (open("/dev/null")) and tells the NVRM kext about it
+// with IOConnectCallScalarMethod(conn, SEL_BINDFD, fd). The kext finds the connection for an fd number by scanning its client
+// table for the FIRST one bound to that number. A pooled connection that is closed keeps its old number in the kernel; when the
+// number is handed out again a second connection binds to it, and from then on the kernel's map ioctl puts the mapping context on
+// the OLD connection while the mmap goes through the new one: IOConnectMapMemory64 -> kIOReturnBadArgument, the old connection
+// keeps an unconsumed context, and every later map on that number fails with NV_ERR_STATE_IN_USE (0x63), reported by Vulkan as
+// VK_ERROR_OUT_OF_DEVICE_MEMORY. (Chrome's GPU process dies of it: pipeline creation, readbacks and submissions fail.)
+//
+// This interposes, for the Vulkan driver image only, IOConnectCallScalarMethod / IOServiceClose / IOConnectMapMemory64: before a
+// connection binds to fd N, any other connection this process bound to N is unbound first. NVMTL_BINDFIX=0 turns it off.
+#pragma once
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#include <IOKit/IOKitLib.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <dlfcn.h>
+
+struct nvbf_tuple { const void *replacement; const void *replacee; };
+extern void dyld_dynamic_interpose(const struct mach_header *mh, const struct nvbf_tuple *array, size_t count);
+
+#define NVBF_N 8192
+static struct { io_connect_t conn; int fd; } g_nvbf[NVBF_N];
+static pthread_mutex_t g_nvbf_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic unsigned long long g_nvbf_fixed, g_nvbf_binds, g_nvbf_mapfail, g_nvbf_full;
+
+// ---- trace: what the process did to RM connections just before a map failed -------------------------------------------
+enum { NVBF_EV_OPEN = 1, NVBF_EV_BIND, NVBF_EV_MAPIOCTL, NVBF_EV_UNMAPIOCTL, NVBF_EV_MMAP, NVBF_EV_CLOSE };
+struct nvbf_ev { unsigned long long seq; uint32_t tid, kind, a, b, c, d; uint64_t e; };
+#define NVBF_EVN 512
+static struct nvbf_ev g_nvbf_ev[NVBF_EVN];
+static _Atomic unsigned long long g_nvbf_seq;
+static void nvbf_ev(uint32_t kind, uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint64_t e)
+{
+    const unsigned long long k = atomic_fetch_add(&g_nvbf_seq, 1);
+    struct nvbf_ev *v = &g_nvbf_ev[k % NVBF_EVN];
+    uint64_t tid = 0; pthread_threadid_np(NULL, &tid);
+    v->tid = (uint32_t)tid; v->kind = kind; v->a = a; v->b = b; v->c = c; v->d = d; v->e = e; v->seq = k + 1;
+}
+static void nvbf_dump(unsigned n, const char *why)
+{
+    const unsigned long long end = atomic_load(&g_nvbf_seq); static const char *nm[] = { "?", "open", "bind", "MAP_IOCTL", "UNMAP_IOCTL", "mmap", "close" };
+    syslog(LOG_ERR, "NullMoth: nvrm trace (%s): last %u RM connection events, oldest first", why, n);
+    for (unsigned long long k = end > n ? end - n : 0; k < end; k++) {
+        const struct nvbf_ev *v = &g_nvbf_ev[k % NVBF_EVN]; if (v->seq != k + 1) continue;
+        syslog(LOG_ERR, "NullMoth: nvrm trace #%llu tid %x %-12s a=%u b=%u c=%u d=0x%x e=0x%llx", v->seq, v->tid, nm[v->kind < 7 ? v->kind : 0], v->a, v->b, v->c, v->d, (unsigned long long)v->e);
+    }
+}
+#define NVBF_MAPPED 4096
+static struct { uint32_t hClient, hMem; } g_nvbf_mapped[NVBF_MAPPED];
+
+static int nvbf_known(io_connect_t conn)
+{
+    int k = 0; pthread_mutex_lock(&g_nvbf_lock);
+    for (int i = 0; i < NVBF_N; i++) if (g_nvbf[i].conn == conn) { k = 1; break; }
+    pthread_mutex_unlock(&g_nvbf_lock); return k;
+}
+static kern_return_t nvbf_IOServiceOpen(io_service_t svc, task_port_t task, uint32_t type, io_connect_t *conn)
+{
+    const kern_return_t kr = IOServiceOpen(svc, task, type, conn);
+    if (kr != KERN_SUCCESS) { static _Atomic int nf; if (atomic_fetch_add(&nf, 1) < 40) { io_name_t cn = "?"; IOObjectGetClass(svc, cn); syslog(LOG_ERR, "NullMoth-diag: IOServiceOpen(%s, type 0x%x) FAILED 0x%x", cn, type, kr); } }
+    if (kr == KERN_SUCCESS && conn && *conn && (IOObjectConformsTo(svc, "NVAccel") || IOObjectConformsTo(svc, "NVRM"))) {
+        nvbf_ev(NVBF_EV_OPEN, (uint32_t)*conn, type, 0, 0, 0);
+        pthread_mutex_lock(&g_nvbf_lock);
+        int placed = 0;
+        for (int i = 0; i < NVBF_N; i++) if (!g_nvbf[i].conn || g_nvbf[i].conn == *conn) { g_nvbf[i].conn = *conn; g_nvbf[i].fd = -1; placed = 1; break; }
+        if (!placed) atomic_fetch_add(&g_nvbf_full, 1);
+        pthread_mutex_unlock(&g_nvbf_lock);
+    }
+    return kr;
+}
+static kern_return_t nvbf_IOConnectCallScalarMethod(mach_port_t conn, uint32_t sel, const uint64_t *in, uint32_t inCnt, uint64_t *out, uint32_t *outCnt)
+{
+    if (sel == 3 && inCnt == 1 && in && nvbf_known(conn)) {   // SEL_BINDFD on one of our NVRM connections
+        const int64_t fd = (int64_t)in[0]; nvbf_ev(NVBF_EV_BIND, (uint32_t)conn, (uint32_t)fd, 0, 0, 0);
+        io_connect_t stale = 0; int found = 0;
+        pthread_mutex_lock(&g_nvbf_lock);
+        { const unsigned long long nb = atomic_fetch_add(&g_nvbf_binds, 1) + 1; if (nb == 1 || !(nb & (nb - 1))) syslog(LOG_ERR, "NullMoth-diag: nvrm bindfix: %llu SEL_BINDFD calls seen so far, %llu corrected", nb, (unsigned long long)atomic_load(&g_nvbf_fixed)); }
+        for (int i = 0; i < NVBF_N; i++) {
+            if (!g_nvbf[i].conn) continue;
+            if (g_nvbf[i].conn == conn) { found = 1; g_nvbf[i].fd = fd >= 0 ? (int)fd : -1; if (fd >= 0) continue; }
+            else if (fd >= 0 && g_nvbf[i].fd == (int)fd) { if (!stale) stale = g_nvbf[i].conn; g_nvbf[i].fd = -1; }
+        }
+        pthread_mutex_unlock(&g_nvbf_lock);
+        if (stale) {
+            uint64_t m = (uint64_t)(int64_t)-2;
+            IOConnectCallScalarMethod(stale, 3, &m, 1, NULL, NULL);
+            const unsigned long long k = atomic_fetch_add(&g_nvbf_fixed, 1) + 1;
+            if (k <= 8 || !(k & (k - 1)))
+                syslog(LOG_ERR, "NullMoth-diag: nvrm bindfd: fd %lld was still bound to another connection - unbound it first (#%llu of %llu binds)",
+                       (long long)fd, k, (unsigned long long)atomic_load(&g_nvbf_binds));
+        }
+    }
+    const kern_return_t rkr = IOConnectCallScalarMethod(conn, sel, in, inCnt, out, outCnt);
+    if (rkr != KERN_SUCCESS && nvbf_known(conn)) { static _Atomic int nf; if (atomic_fetch_add(&nf, 1) < 40) syslog(LOG_ERR, "NullMoth-diag: NVRM scalar method %u (in0 %lld) FAILED 0x%x", sel, (inCnt && in) ? (long long)in[0] : -1LL, rkr); }
+    return rkr;
+}
+static kern_return_t nvbf_IOServiceClose(io_connect_t conn)
+{
+    if (nvbf_known(conn)) nvbf_ev(NVBF_EV_CLOSE, (uint32_t)conn, 0, 0, 0, 0);
+    pthread_mutex_lock(&g_nvbf_lock);
+    for (int i = 0; i < NVBF_N; i++) if (g_nvbf[i].conn == conn) { g_nvbf[i].conn = 0; g_nvbf[i].fd = -1; }
+    pthread_mutex_unlock(&g_nvbf_lock);
+    return IOServiceClose(conn);
+}
+static kern_return_t nvbf_IOConnectMapMemory64(io_connect_t conn, uint32_t type, task_port_t task, mach_vm_address_t *addr, mach_vm_size_t *size, IOOptionBits opt)
+{
+    const kern_return_t kr = IOConnectMapMemory64(conn, type, task, addr, size, opt);
+    const int ours = nvbf_known(conn); if (ours) nvbf_ev(NVBF_EV_MMAP, (uint32_t)conn, (uint32_t)kr, 0, 0, size ? (uint64_t)*size : 0);
+    if (kr != KERN_SUCCESS && ours) {
+        { static _Atomic int dumped; if (atomic_fetch_add(&dumped, 1) < 3) nvbf_dump(40, "IOConnectMapMemory64 failed"); }
+        const unsigned long long k = atomic_fetch_add(&g_nvbf_mapfail, 1) + 1;
+        if (k <= 16 || !(k & (k - 1)))
+            syslog(LOG_ERR, "NullMoth: nvrm: IOConnectMapMemory64 failed 0x%x (#%llu; %llu bindfd corrections so far)", kr, k, (unsigned long long)atomic_load(&g_nvbf_fixed));
+    }
+    return kr;
+}
+
+static kern_return_t nvbf_IOConnectCallMethod(mach_port_t conn, uint32_t sel, const uint64_t *in, uint32_t inCnt, const void *inStruct, size_t inStructCnt,
+                                              uint64_t *out, uint32_t *outCnt, void *outStruct, size_t *outStructCnt)
+{
+    uint32_t cmd = 0, hmem = 0, hcli = 0, fd = 0, len = 0; uint64_t off = 0;
+    if (sel == 1 && inCnt == 1 && in && inStruct && inStructCnt >= 52 && (in[0] == 0x4E || in[0] == 0x4F) && nvbf_known(conn)) {
+        cmd = (uint32_t)in[0]; const uint8_t *b = (const uint8_t *)inStruct; memcpy(&hcli, b, 4); memcpy(&hmem, b + 8, 4);
+        if (cmd == 0x4E) { memcpy(&off, b + 16, 8); memcpy(&len, b + 24, 4); memcpy(&fd, b + 48, 4); }
+    }
+    const kern_return_t kr = IOConnectCallMethod(conn, sel, in, inCnt, inStruct, inStructCnt, out, outCnt, outStruct, outStructCnt);
+    if (cmd && kr == KERN_SUCCESS && outStruct) {
+        const uint8_t *o = (const uint8_t *)outStruct; uint32_t st = 0;
+        if (cmd == 0x4E) memcpy(&st, o + 40, 4); else memcpy(&st, o + 24, 4);
+        if (cmd == 0x4E) {
+            nvbf_ev(NVBF_EV_MAPIOCTL, (uint32_t)conn, hmem, fd, st, ((uint64_t)len << 32) | (uint32_t)off);
+            if (st == 0) { pthread_mutex_lock(&g_nvbf_lock); int dup = 0, slot = -1;
+                for (int i = 0; i < NVBF_MAPPED; i++) { if (g_nvbf_mapped[i].hMem == hmem && g_nvbf_mapped[i].hClient == hcli) dup = 1; if (slot < 0 && !g_nvbf_mapped[i].hMem) slot = i; }
+                if (slot >= 0) { g_nvbf_mapped[slot].hMem = hmem; g_nvbf_mapped[slot].hClient = hcli; }
+                pthread_mutex_unlock(&g_nvbf_lock);
+                if (dup) { static _Atomic int told; if (atomic_fetch_add(&told, 1) < 6) syslog(LOG_ERR, "NullMoth: nvrm: MAP_MEMORY of hMemory 0x%x succeeded while it is ALREADY mapped (fd %u) - RM may hand back the old mapping without a new mapping context", hmem, fd); } }
+        } else {
+            nvbf_ev(NVBF_EV_UNMAPIOCTL, (uint32_t)conn, hmem, 0, st, 0);
+            if (st == 0) { pthread_mutex_lock(&g_nvbf_lock); for (int i = 0; i < NVBF_MAPPED; i++) if (g_nvbf_mapped[i].hMem == hmem && g_nvbf_mapped[i].hClient == hcli) { g_nvbf_mapped[i].hMem = 0; break; } pthread_mutex_unlock(&g_nvbf_lock); }
+        }
+    }
+    return kr;
+}
+// dyld_dynamic_interpose does nothing here (macOS 15: checked with a stand-alone test), so the Vulkan driver's own import
+// pointers are rewritten directly (what fishhook does): every pointer-sized word in its __DATA_CONST / __DATA segments that
+// holds the address of one of the IOKit functions is replaced by the wrapper. Called right after the driver was dlopen'ed.
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+static unsigned nvbf_patch_image(const struct mach_header_64 *mh, intptr_t slide, const void *const old[], const void *const rep[], unsigned n)
+{
+    unsigned hits = 0;
+    const struct load_command *lc = (const struct load_command *)(mh + 1);
+    for (uint32_t c = 0; c < mh->ncmds; c++, lc = (const struct load_command *)((const char *)lc + lc->cmdsize)) {
+        if (lc->cmd != LC_SEGMENT_64) continue;
+        const struct segment_command_64 *seg = (const struct segment_command_64 *)lc;
+        if (strcmp(seg->segname, "__DATA") && strcmp(seg->segname, "__DATA_CONST")) continue;
+        uintptr_t *p = (uintptr_t *)(seg->vmaddr + slide); size_t words = seg->vmsize / sizeof(uintptr_t);
+        for (size_t w = 0; w < words; w++) for (unsigned k = 0; k < n; k++) if (p[w] == (uintptr_t)old[k]) {
+            vm_address_t pg = (vm_address_t)((uintptr_t)&p[w] & ~(uintptr_t)(vm_page_size - 1));
+            if (vm_protect(mach_task_self(), pg, vm_page_size, 0, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY) != KERN_SUCCESS) continue;
+            p[w] = (uintptr_t)rep[k]; hits++;
+        }
+    }
+    return hits;
+}
+static void nvbf_install(void *lib_handle, const char *path)
+{
+    const char *e = getenv("NVMTL_BINDFIX");
+    if (e && e[0] == '0') return;
+    static int done; if (done) return; done = 1; (void)lib_handle;
+    const struct mach_header_64 *mh = NULL; intptr_t slide = 0;
+    for (uint32_t i = 0, n = _dyld_image_count(); i < n; i++) {
+        const char *nm = _dyld_get_image_name(i);
+        if (nm && ((path && !strcmp(nm, path)) || strstr(nm, "libvulkan_nouveau"))) { mh = (const struct mach_header_64 *)_dyld_get_image_header(i); slide = _dyld_get_image_vmaddr_slide(i); break; }
+    }
+    if (!mh) { syslog(LOG_ERR, "NullMoth: nvrm bindfix: Vulkan driver image not found - not installed"); return; }
+    const void *const old[5] = { (const void *)IOConnectCallMethod, (const void *)IOServiceOpen, (const void *)IOConnectCallScalarMethod, (const void *)IOServiceClose, (const void *)IOConnectMapMemory64 };
+    const void *const rep[5] = { (const void *)nvbf_IOConnectCallMethod, (const void *)nvbf_IOServiceOpen, (const void *)nvbf_IOConnectCallScalarMethod, (const void *)nvbf_IOServiceClose, (const void *)nvbf_IOConnectMapMemory64 };
+    const unsigned hits = nvbf_patch_image(mh, slide, old, rep, 5);
+    syslog(LOG_ERR, "NullMoth-diag: nvrm bindfix installed: %u import pointers of the Vulkan driver now go through the fd-binding guard (NVMTL_BINDFIX=%s)", hits, e ?: "unset");
+}
+
+
+
+#include <fcntl.h>
+#include <stdarg.h>
+#include <errno.h>
+static int nvbf_open(const char *path, int flags, ...)
+{
+    mode_t mode = 0; if (flags & O_CREAT) { va_list ap; va_start(ap, flags); mode = (mode_t)va_arg(ap, int); va_end(ap); }
+    int fd = open(path, flags, mode); int e = errno;
+    // The browser's GPU sandbox lets a process read /dev/null but not open it read-write (EPERM). The decoders only need the descriptor as a
+    // placeholder to bind a connection to, so read-only does the same job.
+    if (fd < 0 && e == EPERM && !strcmp(path, "/dev/null") && (flags & O_ACCMODE) == O_RDWR) {
+        fd = open(path, (flags & ~O_ACCMODE) | O_RDONLY, mode); if (fd >= 0) e = 0; else e = errno;
+        static _Atomic int nr; if (atomic_fetch_add(&nr, 1) < 4) syslog(LOG_ERR, "NullMoth-diag: /dev/null read-write refused by the sandbox - placeholder opened read-only -> %d", fd);
+    }
+    static _Atomic int n; if ((fd < 0 || n < 6) && atomic_fetch_add(&n, 1) < 40) syslog(LOG_ERR, "NullMoth-diag: decoder open(%s, 0x%x) -> %d (errno %d)", path, flags, fd, fd < 0 ? e : 0);
+    errno = e; return fd;
+}
+
+// Decoder-output probe: the NVDEC decoders write NV12 into IOSurface-backed pixel buffers with the CPU and then unlock them. Log (from
+// whichever process hosts the decoder - Chrome's GPU process or VTDecoderXPCService) whether the chroma plane really holds data at unlock.
+#include <CoreVideo/CoreVideo.h>
+static CVReturn nvbf_CVUnlock(CVPixelBufferRef pb, CVPixelBufferLockFlags fl)
+{
+    if (!(fl & kCVPixelBufferLock_ReadOnly) && CVPixelBufferGetPlaneCount(pb) == 2) {
+        static _Atomic unsigned n, nblank;
+        unsigned seq = atomic_fetch_add(&n, 1);
+        size_t w = CVPixelBufferGetWidth(pb), h = CVPixelBufferGetHeight(pb);
+        size_t nz[2] = {0, 0}, tot[2] = {0, 0};
+        for (int pl = 0; pl < 2; pl++) {
+            const uint8_t *b = (const uint8_t *)CVPixelBufferGetBaseAddressOfPlane(pb, pl); size_t bpr = CVPixelBufferGetBytesPerRowOfPlane(pb, pl);
+            size_t rows = pl ? h / 2 : h, cols = pl ? w : w; if (!b) continue;
+            for (size_t r = 0; r < rows; r += 4) for (size_t c = 0; c < cols; c += 4) { tot[pl]++; nz[pl] += b[r * bpr + c] != 0; }
+        }
+        int blank = tot[1] && nz[1] * 20 < tot[1];
+        if (blank) atomic_fetch_add(&nblank, 1);
+        if (blank || seq < 40 || (seq % 200) == 0)
+            syslog(LOG_ERR, "NullMoth-diag: DECOUT #%u %zux%zu buf %p luma %zu/%zu chroma %zu/%zu nonzero%s (blank so far %u)", seq, w, h, (void *)pb, nz[0], tot[0], nz[1], tot[1], blank ? "  <== BLANK CHROMA" : "", (unsigned)atomic_load(&nblank));
+    }
+    return CVPixelBufferUnlockBaseAddress(pb, fl);
+}
+
+// The decoder / encoder libraries carry their own copy of nvrm_xnu.c (own connection pool, own /dev/null placeholder fds, own
+// SEL_BINDFD calls). Their connections must be in the same table, or a stale binding of theirs can shadow a Vulkan connection.
+static void nvbf_install_extra(const char *path)
+{
+    const char *e = getenv("NVMTL_BINDFIX");
+    if (e && e[0] == '0') return;
+    const struct mach_header_64 *mh = NULL; intptr_t slide = 0;
+    for (uint32_t i = 0, n = _dyld_image_count(); i < n; i++) {
+        const char *nm = _dyld_get_image_name(i);
+        const char *bn = strrchr(path, '/'); bn = bn ? bn + 1 : path;
+        if (nm && strstr(nm, bn)) { mh = (const struct mach_header_64 *)_dyld_get_image_header(i); slide = _dyld_get_image_vmaddr_slide(i); break; }
+    }
+    if (!mh) { syslog(LOG_ERR, "NullMoth: nvrm bindfix: image %s not found - not installed", path); return; }
+    const void *const old[5] = { (const void *)IOConnectCallMethod, (const void *)IOServiceOpen, (const void *)IOConnectCallScalarMethod, (const void *)IOServiceClose, (const void *)IOConnectMapMemory64 };
+    const void *const rep[5] = { (const void *)nvbf_IOConnectCallMethod, (const void *)nvbf_IOServiceOpen, (const void *)nvbf_IOConnectCallScalarMethod, (const void *)nvbf_IOServiceClose, (const void *)nvbf_IOConnectMapMemory64 };
+    const unsigned hits = nvbf_patch_image(mh, slide, old, rep, 5);
+    unsigned uh = 0;
+    { const void *const oo[1] = { (const void *)open }; const void *const orr[1] = { (const void *)nvbf_open }; uh += nvbf_patch_image(mh, slide, oo, orr, 1); }
+    if (strstr(path, "nvdec")) { const void *const uo[1] = { (const void *)CVPixelBufferUnlockBaseAddress }; const void *const ur[1] = { (const void *)nvbf_CVUnlock }; uh += nvbf_patch_image(mh, slide, uo, ur, 1); }
+    syslog(LOG_ERR, "NullMoth-diag: nvrm bindfix installed on %s: %u import pointers, %u decoder-output probes", path, hits, uh);
+}
+
+// VTDecoderXPCService decodes with Apple's own AppleH264SW when the sandboxed browser asks for H.264: probe its output the same way.
+static void nvbf_sw_image_cb(const struct mach_header *mh, intptr_t slide)
+{
+    Dl_info di; if (!dladdr(mh, &di) || !di.dli_fname || !strstr(di.dli_fname, "AppleH264SW")) return;
+    const void *const uo[1] = { (const void *)CVPixelBufferUnlockBaseAddress }; const void *const ur[1] = { (const void *)nvbf_CVUnlock };
+    unsigned h = nvbf_patch_image((const struct mach_header_64 *)mh, slide, uo, ur, 1);
+    syslog(LOG_ERR, "NullMoth-diag: SW decoder %s: %u output probes installed", di.dli_fname, h);
+}
+#include <pthread.h>
+#include <unistd.h>
+// The decoder dylibs print their errors on stderr, which is /dev/null in an XPC service: forward every line to the system log.
+static void *nvbf_errfwd_thread(void *arg)
+{
+    int fd = (int)(intptr_t)arg; char buf[2048]; size_t n = 0; char c;
+    while (read(fd, &c, 1) == 1) { if (c == '\n' || n == sizeof buf - 1) { buf[n] = 0; if (n) syslog(LOG_ERR, "NullMoth-diag: STDERR %s", buf); n = 0; } else buf[n++] = c; }
+    return NULL;
+}
+static void nvbf_errfwd(void)
+{
+    int p[2]; if (pipe(p)) return; if (dup2(p[1], 2) < 0) return; close(p[1]);
+    pthread_t t; pthread_create(&t, NULL, nvbf_errfwd_thread, (void *)(intptr_t)p[0]); pthread_detach(t);
+}
+static void nvbf_watch_sw(void) { static int once; if (once++) return; nvbf_errfwd(); _dyld_register_func_for_add_image(nvbf_sw_image_cb); }
diff --git a/plugin/nvmtl_diag.h b/plugin/nvmtl_diag.h
new file mode 100644
index 0000000..6b33540
--- /dev/null
+++ b/plugin/nvmtl_diag.h
@@ -0,0 +1,82 @@
+// IOSurface diagnostics that reach the system log even in a release build (tag "NullMoth-diag"), plus a per-surface record
+// of this process's GPU writes so a surface-in can tell when the shared VRAM is about to receive newer GPU contents.
+#pragma once
+#include <syslog.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <os/lock.h>
+#include <time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/time.h>
+#include <stdlib.h>
+static void nvdiag_emit(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvdiag_emit(const char *fmt, ...) {
+    char b[600]; va_list a; va_start(a, fmt); vsnprintf(b, sizeof b, fmt, a); va_end(a);
+    syslog(LOG_ERR, "NullMoth-diag: %s", b);
+}
+#define NVDIAG(lim, ...) do { static _Atomic unsigned nvd_c_; const unsigned nvd_k_ = atomic_fetch_add(&nvd_c_, 1); \
+    if (nvd_k_ < (unsigned)(lim) || !(nvd_k_ % 2000)) nvdiag_emit(__VA_ARGS__); } while (0)
+#define NVSD_N 4096
+static struct { uint32_t id; uint64_t dirty, out; uint32_t dn, on; } g_nvsd[NVSD_N];
+static os_unfair_lock g_nvsd_l = OS_UNFAIR_LOCK_INIT;
+static int nvsd_slot(uint32_t id) {
+    const unsigned h = (id * 2654435761u) % NVSD_N;
+    for (unsigned k = 0; k < 32; k++) { const unsigned i = (h + k) % NVSD_N; if (g_nvsd[i].id == id || !g_nvsd[i].id) return (int)i; }
+    return (int)h;
+}
+// what: 0 = a GPU write was encoded, 1 = the writes were published (surface-out after completion)
+static void nvsd_mark(uint32_t id, int what) {
+    if (!id) return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id);
+    if (g_nvsd[i].id != id) { g_nvsd[i].id = id; g_nvsd[i].dirty = g_nvsd[i].out = 0; g_nvsd[i].dn = g_nvsd[i].on = 0; }
+    // Counted, not timestamped: a publish of frame N that lands after frame N+1 was encoded must not hide N+1's write.
+    if (what) { g_nvsd[i].out = now; if (g_nvsd[i].on < g_nvsd[i].dn) g_nvsd[i].on++; }
+    else { g_nvsd[i].dirty = now; g_nvsd[i].dn++; }
+    os_unfair_lock_unlock(&g_nvsd_l);
+}
+static int nvsd_pending(uint32_t id) {
+    if (!id) return 0;
+    os_unfair_lock_lock(&g_nvsd_l);
+    const int i = nvsd_slot(id); const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    // The age limit keeps a write that is never published (command buffer dropped) from blocking uploads for good.
+    const int p = g_nvsd[i].id == id && g_nvsd[i].dn > g_nvsd[i].on && now - g_nvsd[i].dirty < 500000000ull;
+    os_unfair_lock_unlock(&g_nvsd_l);
+    return p;
+}
+static int nvsd_guard_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_SURFIN_GUARD"); on = !(e && e[0] == '0');
+        nvdiag_emit("surface-in guard %s (NVMTL_SURFIN_GUARD=%s): a texture over shared IOSurface VRAM that this process has GPU writes "
+                    "in flight for does %s upload the surface's CPU pages over it", on ? "ON" : "off", e ? e : "unset", on ? "NOT" : "still"); }
+    return on;
+}
+
+// Window-sized shared-VRAM IOSurfaces (>= NVMTL_SURF_SHARE_MINPX pixels, below the 7.2M-pixel scan-out framebuffers): every
+// event on them goes to /private/var/tmp/nvmtl-big.log (not the system log: its per-call-site caps were used up at boot).
+// The budget is per process; the draw trace spends ~7 lines per draw, and the post-login window churn alone ran at ~4000
+// lines/s, so the cap must be large enough to survive a login burst plus the repro. With the trace switch absent nothing
+// is written and nothing is consumed, so the budget only ever burns while a repro is actually running.
+#define NVBIG_RANGE(w, h) ((unsigned long)(w) * (unsigned long)(h) >= 3000000ul && (unsigned long)(w) * (unsigned long)(h) < 7000000ul)
+#define NVBIG_BUDGET 2000000u
+static void nvbig(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void nvbig(const char *fmt, ...) {
+    static _Atomic unsigned n; static int fd = -2;
+    static _Atomic uint64_t gate_at; static _Atomic int gate_on;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= atomic_load_explicit(&gate_at, memory_order_relaxed)) {
+        atomic_store_explicit(&gate_at, now + 250000000ull, memory_order_relaxed);
+        atomic_store_explicit(&gate_on, access("/private/var/tmp/nvmtl-trace-request", F_OK) == 0, memory_order_relaxed);
+    }
+    if (!atomic_load_explicit(&gate_on, memory_order_relaxed)) return;
+    if (atomic_fetch_add(&n, 1) >= NVBIG_BUDGET) return;
+    if (fd == -2) fd = open("/private/var/tmp/nvmtl-big.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
+    if (fd < 0) return;
+    char b[700]; struct timeval tv; gettimeofday(&tv, NULL); struct tm tm; time_t t = tv.tv_sec; localtime_r(&t, &tm);
+    int k = snprintf(b, sizeof b, "%02d:%02d:%02d.%03d %s[%d] ", tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000), getprogname(), (int)getpid());
+    va_list a; va_start(a, fmt); k += vsnprintf(b + k, sizeof b - (size_t)k - 2, fmt, a); va_end(a);
+    if (k > (int)sizeof b - 2) k = (int)sizeof b - 2;
+    b[k++] = '\n'; (void)!write(fd, b, (size_t)k);
+}
diff --git a/plugin/nvmtl_oslog.h b/plugin/nvmtl_oslog.h
new file mode 100644
index 0000000..a4a8941
--- /dev/null
+++ b/plugin/nvmtl_oslog.h
@@ -0,0 +1,21 @@
+// nvmtl_oslog.h - the plugin logs with syslog(), which goes through a mach service that Chrome's sandboxed GPU process may not
+// reach (its NullMoth lines never showed up). os_log is allowed everywhere, so every syslog() call of the plugin goes there.
+#pragma once
+#include <os/log.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <syslog.h>
+static int g_nvos_stderr;
+// Chrome's sandboxed GPU process cannot reach the log daemon, but it keeps its inherited stderr: NVMTL_LOG_STDERR=1 (read before the
+// plugin clears its NVMTL_ environment) copies every log line there.
+__attribute__((constructor)) static void nvos_init(void) { const char *e = getenv("NVMTL_LOG_STDERR"); g_nvos_stderr = e && *e == '1'; }
+static void nvos_syslog(int prio, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void nvos_syslog(int prio, const char *fmt, ...)
+{
+    char b[1024]; va_list ap; va_start(ap, fmt); vsnprintf(b, sizeof b, fmt, ap); va_end(ap);
+    if (g_nvos_stderr) fprintf(stderr, "[nvmtl pid %d] %s\n", getpid(), b);
+    os_log_with_type(OS_LOG_DEFAULT, prio <= LOG_ERR ? OS_LOG_TYPE_ERROR : OS_LOG_TYPE_DEFAULT, "%{public}s", b);
+}
+#define syslog nvos_syslog
