+// One source component (index k of a vertex attribute) as both a float and a 64-bit integer.
+static void nvmtl_si_comp(const uint8_t *p, const nvmtl_si_fmt *f, unsigned k, float *fv, int64_t *iv) {
+    const uint8_t *c = p + k * f->size;
+    switch (f->kind) {
+    case 0: { float x; memcpy(&x, c, 4); *fv = x; *iv = (int64_t)x; return; }
+    case 1: { __fp16 x; memcpy(&x, c, 2); *fv = (float)x; *iv = (int64_t)*fv; return; }
+    default: break;
+    }
+    int64_t v;
+    if (f->kind == 2) { v = f->size == 1 ? (int64_t)*(const int8_t *)c : f->size == 2 ? (int64_t)*(const int16_t *)c : (int64_t)*(const int32_t *)c; }
+    else { uint32_t u = 0; memcpy(&u, c, f->size); v = (int64_t)u; }
+    *iv = v;
+    if (f->norm) {
+        const double mx = f->kind == 2 ? (double)((1ll << (f->size * 8 - 1)) - 1) : (double)((1ull << (f->size * 8)) - 1);
+        double x = (double)v / mx; *fv = (float)(x < -1.0 ? -1.0 : x);
