+    else if (!strncmp(t, "uint", 4)) { k = 3; n = 4; } else if (!strncmp(t, "int", 3)) { k = 2; n = 3; } else return NO;
+    unsigned l = t[n] == 0 ? 1 : (t[n] >= '2' && t[n] <= '4' && t[n + 1] == 0) ? (unsigned)(t[n] - '0') : 0;
