+        const char *e = getenv("NVMTL_TILED_RT"); const char *pn = getprogname();
+        const int ws = pn && !strcmp(pn, "WindowServer");
+        on = e && *e ? atoi(e) : 1;               // 0 off, 1 apps (not WindowServer), 2 every process
+        if (on == 1 && ws) on = 0;
+        syslog(LOG_ERR, "NullMoth-diag: tiled render shadow for shared-VRAM render targets %s in %s (NVMTL_TILED_RT=%s)",
+               on ? "ON" : "off", pn ? pn : "?", e ? e : "unset");
+    }
+    return on;
+}
+// Render-shadow park. Chrome draws a masked danmaku layer into a NEW IOSurface on most frames (SkiaRenderer's render-pass
+// overlays live about one frame), so every frame paid for a fresh tiled shadow - a VRAM allocation, two GPU VA ranges and
+// their maps (~0.3 ms) - and for freeing the last one (~0.15 ms of RM calls). A dead texture's shadow is parked here instead
+// and handed to the next shadow of the same size and format. Its GPU work is over: a texture is released only after the
+// command buffers that used it completed, which is why -dealloc already destroyed the shadow outright. Its stale contents are
+// never read: a shadow's first pass either clears it or primes it from the surface, the same as a new one. Its layout field
+// still tells the barriers where it is. Parked shadows are freed after ~2 s unused, and at once when VRAM is refused.
+// NVMTL_RSH_PARK=0 (nvrm610.conf) frees every shadow at once, as before.
+#define NVMTL_RSHPARK_N     8
+#define NVMTL_RSHPARK_BYTES (160ull << 20)
+#define NVMTL_RSHPARK_AGE_NS 2000000000ull
+static pthread_mutex_t g_rpark_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { nvk_image img; uint64_t t; } g_rpark[NVMTL_RSHPARK_N];
+static unsigned g_rpark_n; static uint64_t g_rpark_bytes; static int g_rpark_timer;
+static _Atomic uint64_t g_rpark_parked, g_rpark_reused, g_rpark_aged, g_rpark_dropped;
+static int rpark_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_RSH_PARK"); on = !(e && e[0] == '0');
+        nvlog("render-shadow park: %s (NVMTL_RSH_PARK=%s)", on ? "a dead texture's tiled shadow is reused by the next shadow of its size"
+              : "OFF - every shadow is freed with its texture", e ? e : "unset"); }
+    return on;
+}
+static void rpark_census(const char *what)
+{
+    const uint64_t n = atomic_load(&g_rpark_parked) + atomic_load(&g_rpark_reused);
+    if (n & (n - 1)) return;
+    nvlog("render-shadow park (%s): %llu parked, %llu reused, %llu aged out, %llu dropped; %u held, %llu bytes", what,
+          (unsigned long long)atomic_load(&g_rpark_parked), (unsigned long long)atomic_load(&g_rpark_reused),
+          (unsigned long long)atomic_load(&g_rpark_aged), (unsigned long long)atomic_load(&g_rpark_dropped),
+          g_rpark_n, (unsigned long long)g_rpark_bytes);
+}
+// Frees parked shadows older than min_age_ns (0 = all). Returns how many are still held.
+static unsigned rpark_evict(uint64_t min_age_ns)
+{
+    nvk_image out[NVMTL_RSHPARK_N]; unsigned nout = 0, left;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    pthread_mutex_lock(&g_rpark_lock);
+    unsigned w = 0;
+    for (unsigned k = 0; k < g_rpark_n; k++) {
+        if (now - g_rpark[k].t >= min_age_ns) { g_rpark_bytes -= g_rpark[k].img.alloc; out[nout++] = g_rpark[k].img; }
+        else g_rpark[w++] = g_rpark[k]; }
+    g_rpark_n = left = w;
+    pthread_mutex_unlock(&g_rpark_lock);
+    for (unsigned k = 0; k < nout; k++) nvmtl_vk_image_destroy(&out[k]);
+    if (nout) atomic_fetch_add(min_age_ns ? &g_rpark_aged : &g_rpark_dropped, nout);
+    return left;
+}
+static void rpark_drain(void) { rpark_evict(0); }
+static void rpark_arm_timer(void)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)NVMTL_RSHPARK_AGE_NS), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        const unsigned left = rpark_evict(NVMTL_RSHPARK_AGE_NS);
+        pthread_mutex_lock(&g_rpark_lock); const int again = left && g_rpark_n; if (!again) g_rpark_timer = 0; pthread_mutex_unlock(&g_rpark_lock);
+        if (again) rpark_arm_timer();
+    });
+}
+void nvmtl_vk_rsh_release(nvk_image *i)
+{
+    if (!i || !i->img) return;
+    if (g_state != 1 || !rpark_on() || i->placed || i->sysmem || !i->alloc || i->alloc > (NVMTL_RSHPARK_BYTES >> 1)) { nvmtl_vk_image_destroy(i); return; }
+    nvk_image victim = {0}; int arm = 0;
+    pthread_mutex_lock(&g_rpark_lock);
+    if (g_rpark_n == NVMTL_RSHPARK_N || g_rpark_bytes + i->alloc > NVMTL_RSHPARK_BYTES) {   // full: the oldest goes
+        if (g_rpark_n) { victim = g_rpark[0].img; g_rpark_bytes -= victim.alloc;
+            memmove(&g_rpark[0], &g_rpark[1], (g_rpark_n - 1) * sizeof g_rpark[0]); g_rpark_n--; } }
+    if (g_rpark_n < NVMTL_RSHPARK_N && g_rpark_bytes + i->alloc <= NVMTL_RSHPARK_BYTES) {
+        g_rpark[g_rpark_n].img = *i; g_rpark[g_rpark_n].t = clock_gettime_nsec_np(CLOCK_UPTIME_RAW); g_rpark_n++; g_rpark_bytes += i->alloc;
+        memset(i, 0, sizeof *i);
+        if (!g_rpark_timer) { g_rpark_timer = 1; arm = 1; } }
+    pthread_mutex_unlock(&g_rpark_lock);
+    if (victim.img) { nvmtl_vk_image_destroy(&victim); atomic_fetch_add(&g_rpark_dropped, 1); }
+    if (i->img) { nvmtl_vk_image_destroy(i); atomic_fetch_add(&g_rpark_dropped, 1); return; }
+    atomic_fetch_add(&g_rpark_parked, 1); rpark_census("park");
+    if (arm) rpark_arm_timer();
+}
+// Every parked image came from nvmtl_vk_rsh_create's one create_typed call, so size and format pick an identical one.
+static int rpark_take(uint32_t w, uint32_t h, uint32_t fmt, nvk_image *out)
+{
+    if (!rpark_on()) return -1;
+    int hit = -1;
+    pthread_mutex_lock(&g_rpark_lock);
+    for (unsigned k = g_rpark_n; k-- > 0; ) if (g_rpark[k].img.w == w && g_rpark[k].img.h == h && g_rpark[k].img.fmt == fmt) { hit = (int)k; break; }
+    if (hit >= 0) {
+        *out = g_rpark[hit].img; g_rpark_bytes -= out->alloc;
+        memmove(&g_rpark[hit], &g_rpark[hit + 1], (g_rpark_n - (unsigned)hit - 1) * sizeof g_rpark[0]); g_rpark_n--; }
+    pthread_mutex_unlock(&g_rpark_lock);
+    if (hit < 0) return -1;
+    atomic_fetch_add(&g_rpark_reused, 1); rpark_census("reuse");
+    return 0;
+}
+int nvmtl_vk_rsh_create(const nvk_image *lin, nvk_image *out)
+{
+    if (!lin || !lin->img || !lin->w || !lin->h || lin->samples > 1) return -1;
+    if (!rpark_take(lin->w, lin->h, lin->fmt, out)) return 0;
+    int r = nvmtl_vk_image_create_typed(lin->w, lin->h, lin->fmt, lin->bpp, 0, 1, 0, 2, 1, out);
+    if (r && g_rpark_n) { rpark_drain(); r = nvmtl_vk_image_create_typed(lin->w, lin->h, lin->fmt, lin->bpp, 0, 1, 0, 2, 1, out); }
+    return r;
+}
+int nvmtl_vk_cmd_rsh_copy(nvk_cmdbuf *c, nvk_image *from, nvk_image *to)
+{
+    if (!c || !from || !to || !from->img || !to->img || c->in_rp) return -1;
+    if (from->w != to->w || from->h != to->h || from->fmt != to->fmt) return -1;
+    const VkImageSubresourceRange r = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    VkImageMemoryBarrier pre[2] = {
+        { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_MEMORY_READ_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+          (VkImageLayout)from->layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)from->img, r },
+        { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_MEMORY_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+          VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)to->img, r } };
+    pvkCmdPipelineBarrier(c->cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 2, pre);
+    from->layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    VkImageCopy ic = { { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, { 0, 0, 0 }, { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, { 0, 0, 0 }, { to->w, to->h, 1 } };
+    pvkCmdCopyImage(c->cb, (VkImage)from->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, (VkImage)to->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &ic);
+    VkImageMemoryBarrier post[2] = {
+        { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+          VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)to->img, r },
+        { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+          VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)from->img, r } };
+    pvkCmdPipelineBarrier(c->cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 2, post);
+    to->layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    return 0;
+}
